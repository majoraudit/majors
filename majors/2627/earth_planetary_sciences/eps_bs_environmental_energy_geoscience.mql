// Earth and Planetary Sciences B.S. -- Environmental and Energy Geoscience concentration.
// At least 11 term courses beyond the prerequisites, including the senior requirement.
SELECT 1 FROM [CHEM 1650, CHEM 1670] : "Prerequisite: CHEM 1650 or 1670" : 1;
SELECT 1 FROM [MATH 1200, ENAS 1510] : "Prerequisite: multivariable calculus (MATH 1200 or ENAS 1510)" : 1;
SELECT 1 FROM [
    SELECT 2 FROM [PHYS 1700, PHYS 1710], SELECT 2 FROM [PHYS 1800, PHYS 1810], SELECT 2 FROM [PHYS 2000, PHYS 2010],
    SELECT 2 FROM [SELECT 2 FROM [BIOL 1010, BIOL 1020], SELECT 1 FROM [SELECT 2 FROM [BIOL 1030, BIOL 1040], SELECT 2 FROM [EPS 1250, EPS 1260L]]]
] : "Prerequisite: physics sequence, or cellular and evolutionary biology" : 1;

$intro = [EPS 1000, EPS 1010, SELECT 2 FROM [EPS 1100, EPS 1110L], SELECT 2 FROM [EPS 1250, EPS 1260L], EPS 1400];
SELECT 2 FROM [$intro] : "Two introductory EPS courses" : 2;
$core = [EPS 2320, EPS 2550, EPS 2740, EPS 2750, EPS 3100, EPS 2100, EPS 2200, EPS 3120, EPS 3220, EPS 3230, EPS 3620, PLACEMENT("Higher-level EPS course substituted with DUS permission")];
SELECT 4 FROM [$core] : "Four core courses" : 2;
$el = [RANGE(EPS 2000, EPS 9999), RANGE(EVST 0000, EVST 9999), RANGE(E&EB 0000, E&EB 9999), RANGE(EEB 0000, EEB 9999), RANGE(ENAS 0000, ENAS 9999), RANGE(ENVE 0000, ENVE 9999), RANGE(MENG 0000, MENG 9999), RANGE(CENG 0000, CENG 9999), PLACEMENT("Elective in a related field approved by the DUS")];
SELECT 4 FROM [$el, $el, $el, $el] : "Four electives (EPS, EVST, EEB, Engineering, or related fields; core courses may count)" : 3;
SELECT 2 FROM [RANGE(EPS 2000, EPS 9999), RANGE(EPS 2000, EPS 9999)] : "At least two electives from EPS" : 3;

SELECT 1 FROM [CLASS(EPS 4920), SELECT 2 FROM [EPS 4900, EPS 4910]] : "Senior essay (EPS 4920) or, with faculty permission, two-term senior thesis (EPS 4900, 4910)" : 1;
