// Spanish B.A. (intensive major): twelve term courses beyond the prerequisite, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/spanish/
program spanish_ba_intensive {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact spanish_placement "Equivalent of SPAN 1400 or above by placement examination, advanced placement, or study abroad":
  placement { test: "Spanish placement", result: "SPAN 1400 or above" };

requirement prereq "Prerequisite: SPAN 1400, 1450, or 1500, or an equivalent" [prerequisite] {
  slot from [SPAN 1400, SPAN 1450, SPAN 1500];
}

effect placed when fact spanish_placement: waive prereq;

requirement intro "Required introductory course: SPAN 2200" [core] {
  slot from [SPAN 2200];
}

requirement intermediate "Two courses numbered SPAN 2200-2999" [core] {
  courses at least 2 where course.subject = "SPAN" and course.number >= 2201 and course.number <= 2999;
}

requirement advanced "Five courses numbered SPAN 3000 or higher" [core] {
  courses at least 5 where course.subject = "SPAN" and course.number >= 3000 and course.number <= 4899;
}

requirement electives "Three electives numbered SPAN 2000 or higher, or a first-year seminar taught in Spanish (one course in another language with DUS approval)" [elective] {
  courses at least 3
    where course.subject = "SPAN" and (course.number >= 2000 and course.number <= 4899 or course.number <= 999)
      or attempt.approved_for contains "electives";
  constraint other_language "At most one course taught in a language other than Spanish":
    at most 1 attempts where course.language != "Spanish";
}

requirement senior "Senior requirement: senior project (SPAN 4900)" [senior] {
  slot from [SPAN 4900];
}

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Twelve term courses beyond the prerequisite" in roles [core, elective, senior]:
  total at least 12 attempts;
