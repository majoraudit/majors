// Urban Studies B.A. -- 13 course credits including the senior requirement.
// Urban Labs carry 1.5 credits, so students taking two Urban Labs need fewer electives.
$survey = [URBN 1300, URBN 1101, URBN 1100, URBN 1102, EVST 3226, ARCH 1001, TAG("YC URBN Survey Course")];
$lab = [URBN 3601, URBN 3602, URBN 3603, URBN 3604, URBN 3605, TAG("YC URBN Urban Lab")];
$methods = [URBN 2000, URBN 3601, URBN 3602, URBN 3603, URBN 3604, URBN 3605, ANTH 3720, EVST 2290, TAG("YC URBN Methods Course")];
$elective = [TAG("YC URBN Elective"), PLACEMENT("Elective approved by petition to the DUS")];

SELECT 3 FROM [$survey] : "Three survey courses (completed by the end of the second year)" : 2;
SELECT 1 FROM [URBN 1300, URBN 1101, URBN 1100, URBN 1102, RANGE_TAG(URBN 0000, URBN 9999, "YC URBN Survey Course")] : "At least one survey must be a URBN course" : 2;
SELECT 1 FROM [$lab] : "Methods: one Urban Lab (1.5 credits)" : 2;
SELECT 2 FROM [$methods] : "Methods: two additional methods courses" : 2;

// Four to six electives depending on course credit values and the senior requirement option.
SELECT 4-6 FROM [$elective, $elective, $elective, $elective, $elective, $elective] : "Electives (five with the two-term senior project, six with the one-term option; fewer with two Urban Labs)" : 4;

SELECT 1 FROM [
    SELECT 2 FROM [URBN 4900, URBN 4901],
    SELECT 2 FROM [RANGE(URBN 4000, URBN 4899), $elective]
] : "Senior requirement: yearlong project (URBN 4900 and 4901), or an advanced seminar (URBN 4000-4910) with a 6,000-word paper plus an additional elective" : 1;
