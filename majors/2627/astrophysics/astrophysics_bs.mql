// Astrophysics B.S.: twelve courses beyond the prerequisites, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/astronomy/
program astrophysics_bs {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement prereq_physics "Prerequisite: PHYS 1800 and 1810, PHYS 2000 and 2010, or PHYS 2600 and 2610" [prerequisite] {
  children at least 1;
  requirement prereq_physics_1800 "PHYS 1800 and 1810" { courses exactly 2 from [PHYS 1800, PHYS 1810]; }
  requirement prereq_physics_2000 "PHYS 2000 and 2010" { courses exactly 2 from [PHYS 2000, PHYS 2010]; }
  requirement prereq_physics_2600 "PHYS 2600 and 2610" { courses exactly 2 from [PHYS 2600, PHYS 2610]; }
}

requirement prereq_lab "Prerequisite: PHYS 1650L and 1660L, or PHYS 2050L and 2060L (ASTR 1550 may replace one term)" [prerequisite] {
  courses at least 2 from [PHYS 1650L, PHYS 1660L, PHYS 2050L, PHYS 2060L, ASTR 1550];
  constraint one_astr_1550 "ASTR 1550 replaces at most one term of laboratory":
    at most 1 attempts where course.code = "ASTR1550";
}

requirement prereq_calculus "Prerequisite: MATH 1120 and 1150" [prerequisite] {
  courses exactly 2 from [MATH 1120, MATH 1150];
}

requirement prereq_multivariable "Prerequisite: MATH 1200 or ENAS 1510" [prerequisite] {
  slot from [MATH 1200, ENAS 1510];
}

requirement intro_astronomy "ASTR 2100 or 2200" [core] {
  slot from [ASTR 2100, ASTR 2200];
}

requirement astronomy_core "ASTR 2550, 3100, and 3200" [core] {
  courses exactly 3 from [ASTR 2550, ASTR 3100, ASTR 3200];
}

requirement physics "Three physics courses numbered 4000 or higher (normally PHYS 4010, 4020, and 4390)" [core] {
  courses at least 3 where course.subject = "PHYS" and course.number >= 4000;
}

requirement physics_or_astronomy "One additional 4000-level physics course or an Astronomy elective numbered 3000 or higher" [elective] {
  slot where course.subject = "PHYS" and course.number >= 4000 or course.subject = "ASTR" and course.number >= 3000;
}

requirement differential_equations "Differential equations (MATH 2460, PHYS 4000, or ENAS 1940)" [core] {
  slot from [MATH 2460, PHYS 4000, ENAS 1940];
}

requirement mathematics "An additional mathematics course numbered 2000 or higher, or a statistics or computing course such as CPSC 2010 or ASTR 3560" [core] {
  slot where course.subject = "MATH" and course.number >= 2000
    or course.code in ["CPSC2010", "ASTR3560"] or course.subject = "S&DS"
    or attempt.approved_for contains "mathematics";
}

requirement senior "Two-term senior research project (ASTR 4900 and 4910)" [senior] {
  courses exactly 2 from [ASTR 4900, ASTR 4910];
}

constraint six_astronomy "At least six courses in astronomy" in roles [core, elective, senior]:
  at least 6 attempts where course.subject = "ASTR";

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Twelve courses beyond the prerequisites" in roles [core, elective, senior]:
  total at least 12 attempts;
