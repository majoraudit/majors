// Music B.A.: thirteen courses, two intermediate and one advanced course in each of four groups,
// and the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/music/
// Up to three performance-instruction course credits may count toward the major.
program music_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement group_theory "Group I (music theory and technology): two intermediate courses and one advanced course" [core] {
  children exactly 2;
  requirement group_theory_intermediate "Two intermediate Group I courses (one 1000-level course may replace one, with DUS permission)" {
    courses at least 2 where course.attributes contains "YC MUSI Intermediate Grp I" or attempt.approved_for contains "group_theory_intermediate";
  }
  requirement group_theory_advanced "One advanced Group I course" {
    slot where course.attributes contains "YC MUSI Advanced Grp I";
  }
}

requirement group_composition "Group II (composition, technology, and performance): two intermediate courses and one advanced course" [core] {
  children exactly 2;
  requirement group_composition_intermediate "Two intermediate Group II courses (one 1000-level course may replace one, with DUS permission)" {
    courses at least 2 where course.attributes contains "YC MUSI Intermediate Grp II" or attempt.approved_for contains "group_composition_intermediate";
  }
  requirement group_composition_advanced "One advanced Group II course" {
    slot where course.attributes contains "YC MUSI Advanced Grp II";
  }
}

requirement group_western "Group III (the Western art-music tradition): two intermediate courses and one advanced course" [core] {
  children exactly 2;
  requirement group_western_intermediate "Two intermediate Group III courses (one 1000-level course may replace one, with DUS permission)" {
    courses at least 2 where course.attributes contains "YC MUSI Intermediate Grp III" or attempt.approved_for contains "group_western_intermediate";
  }
  requirement group_western_advanced "One advanced Group III course" {
    slot where course.attributes contains "YC MUSI Advanced Grp III";
  }
}

requirement group_world "Group IV (popular, vernacular, or non-Western music): two intermediate courses and one advanced course" [core] {
  children exactly 2;
  requirement group_world_intermediate "Two intermediate Group IV courses (one 1000-level course may replace one, with DUS permission)" {
    courses at least 2 where course.attributes contains "YC MUSI Intermediate Grp IV" or attempt.approved_for contains "group_world_intermediate";
  }
  requirement group_world_advanced "One advanced Group IV course" {
    slot where course.attributes contains "YC MUSI Advanced Grp IV";
  }
}

requirement senior "Senior requirement: a one-term senior essay, project, composition, or recital (MUSI 4996-4999)" [senior] {
  slot where course.subject = "MUSI" and course.number >= 4996 and course.number <= 4999;
}

constraint one_1000_level "At most one 1000-level course in place of an intermediate course, with DUS permission" in roles [core]:
  limit 1 attempts where course.number < 2000;

constraint performance_limit "At most three performance-instruction credits count toward the major" in program:
  limit 3 credits where attempt.approved_for contains "performance_instruction";

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Thirteen courses including the senior requirement" in roles [core, senior]:
  total at least 13 attempts;
