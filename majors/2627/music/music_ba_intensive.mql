// Music B.A. -- intensive major: 14 term courses numbered 2000 or above, including the senior requirement.
// With DUS permission, one 1000-level course may replace an intermediate course in the appropriate group.
// Up to three performance instruction courses may count toward the major.
$sub1000 = PLACEMENT("1000-level course substituted for an intermediate course with DUS permission");

SELECT 2 FROM [TAG("YC MUSI Intermediate Grp I"), TAG("YC MUSI Intermediate Grp I"), $sub1000] : "Group I (music theory and technology): two intermediate courses" : 2;
SELECT 1 FROM [TAG("YC MUSI Advanced Grp I")] : "Group I (music theory and technology): one advanced course" : 2;
SELECT 2 FROM [TAG("YC MUSI Intermediate Grp II"), TAG("YC MUSI Intermediate Grp II"), $sub1000] : "Group II (composition, technology, and performance): two intermediate courses" : 2;
SELECT 1 FROM [TAG("YC MUSI Advanced Grp II")] : "Group II (composition, technology, and performance): one advanced course" : 2;
SELECT 2 FROM [TAG("YC MUSI Intermediate Grp III"), TAG("YC MUSI Intermediate Grp III"), $sub1000] : "Group III (Western art-music tradition): two intermediate courses" : 2;
SELECT 1 FROM [TAG("YC MUSI Advanced Grp III")] : "Group III (Western art-music tradition): one advanced course" : 2;
SELECT 2 FROM [TAG("YC MUSI Intermediate Grp IV"), TAG("YC MUSI Intermediate Grp IV"), $sub1000] : "Group IV (popular, vernacular, or non-Western music): two intermediate courses" : 2;
SELECT 1 FROM [TAG("YC MUSI Advanced Grp IV")] : "Group IV (popular, vernacular, or non-Western music): one advanced course" : 2;
LIMIT 1 FROM $sub1000 : "At most one 1000-level substitution" : 3;

SELECT 2 FROM [RANGE(MUSI 4997, MUSI 4999), RANGE(MUSI 4997, MUSI 4999)] : "Senior requirement: two-term senior essay or project in music research or composition (MUSI 4997-4999)" : 1;
SELECT 1 FROM PLACEMENT("Admission to the intensive major after satisfactory first-term senior project work") : "Intensive major admission" : 1;
