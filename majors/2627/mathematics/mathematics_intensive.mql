// Mathematics intensive major -- all requirements of the B.A. (10 courses) or B.S. (12 courses), plus MATH 3050, 3100, and 3500
// and two graduate courses (5000+) in Mathematics among the required courses.
$math = [RANGE(MATH 2250, MATH 4699), RANGE(MATH 4701, MATH 5999)];
$dist = TAG("YC MATH Distribution");
$outside = PLACEMENT("Math-intensive course from another department approved by the DUS");
$physci = [ASTR 4180, ASTR 4300, CHEM 3330, CHEM 4700, PHYS 4010, PHYS 4100, PHYS 4020, PHYS 4300, PHYS 4400, PHYS 4410, PHYS 4500, PLACEMENT("Advanced physical science course approved by the DUS")];

SELECT 1 FROM [MATH 1150, PLACEMENT("Equivalent of MATH 1150 (e.g., AP Calculus BC score of 4 or 5)")] : "Prerequisite: single-variable calculus through MATH 1150" : 1;

SELECT 1 FROM [MATH 2250, MATH 2260] : "Introductory sequence: linear algebra with proofs (MATH 2250 or 2260)" : 1;
SELECT 1 FROM [MATH 2550, MATH 2560] : "Introductory sequence: real analysis (MATH 2550 or 2560)" : 1;
SELECT 1 FROM [MATH 3020, MATH 1200] : "Introductory sequence: vector analysis or multivariable calculus (MATH 3020 or 1200)" : 1;
SELECT 1 FROM [MATH 3500, PLACEMENT("Higher-level algebra course (typically MATH 3700) with prior written DUS permission")] : "Algebra (MATH 3500)" : 1;
SELECT 2 FROM [MATH 3050, MATH 3100] : "Intensive: both MATH 3050 and MATH 3100" : 1;
// Graduate courses numbered 6000 and above, and MATH 4700, do not count.
SELECT 3 FROM [$dist, $dist, $dist] : "Three courses carrying the Math distribution attribute" : 2;
// The graduate courses count as electives but not toward any specific requirement (such as distribution).
SELECT 1 FROM [RANGE(MATH 5000, MATH 5999), PLACEMENT("Equivalent independent study approved by the DUS")] : "Intensive: graduate Mathematics course (counts as an elective)" : 2;
SELECT 1 FROM [RANGE(MATH 5000, MATH 5999), PLACEMENT("Equivalent independent study approved by the DUS")] : "Intensive: second graduate Mathematics course" : 2;
LIMIT 2 FROM [$outside, $outside] : "Up to two math-intensive courses from other departments (DUS approval)" : 3;

SELECT 1 FROM [RANGE(MATH 4800, MATH 4890), PLACEMENT("MATH 4750 senior essay with DUS consent")] : "Senior requirement: seminar numbered MATH 4800-4890, or MATH 4750 with DUS consent" : 1;

SELECT 1 FROM [PLACEMENT("B.A. degree (no additional courses)"), SELECT 2 FROM [$physci, $physci]] : "Degree: B.A., or B.S. with two advanced courses in the physical sciences" : 2;
