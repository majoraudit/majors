// Linguistics B.A. -- 12 term courses in linguistics and related areas, including the senior requirement.
$breadth = [LING 1179, LING 2120, LING 2200, LING 2270, LING 2320, LING 2530, LING 2630, LING 2750, LING 2790, LING 3610];
$elective = [RANGE(LING 0000, LING 9999), PLACEMENT("Related course (anthropology, classics, cognitive science, computer science, English, philosophy, psychology, or a foreign language) approved by the DUS")];

SELECT 4 FROM [$breadth, PLACEMENT("Breadth course substituted with DUS approval")] : "Breadth: four of the ten listed courses" : 2;
SELECT 1 FROM [$breadth, LING 1100, LING 1160, PLACEMENT("Multi-subfield course approved by the DUS")] : "Breadth: one additional course (listed course, LING 1100, or LING 1160)" : 2;

SELECT 1 FROM [
    SELECT 2 FROM [TAG("YC LING Depth Historical Ling"), TAG("YC LING Depth Historical Ling")],
    SELECT 2 FROM [TAG("YC LING Depth Comp Linguistic"), TAG("YC LING Depth Comp Linguistic")],
    SELECT 2 FROM [TAG("YC LING Depth Phonetics"), TAG("YC LING Depth Phonetics")],
    SELECT 2 FROM [TAG("YC LING Depth Phonology"), TAG("YC LING Depth Phonology")],
    SELECT 2 FROM [TAG("YC LING Depth Syntax"), TAG("YC LING Depth Syntax")],
    SELECT 2 FROM [TAG("YC LING Depth Semntcs/Pragmat"), TAG("YC LING Depth Semntcs/Pragmat")],
    SELECT 2 FROM [TAG("YC LING Depth Morphology"), TAG("YC LING Depth Morphology")],
    SELECT 2 FROM [TAG("YC LING Depth Lang&Mind/Brain"), TAG("YC LING Depth Lang&Mind/Brain")]
] : "Depth: two courses beyond the introductory level in one area of linguistics" : 2;

SELECT 3 FROM [$elective, $elective, $elective] : "Three electives" : 3;
SELECT 1 FROM [RANGE(LING 2000, LING 9999), PLACEMENT("Related elective at the 2000 level or above approved by the DUS")] : "At least one elective at the 2000 level or above" : 3;
LIMIT 2 FROM [PLACEMENT("Foreign language course"), PLACEMENT("Foreign language course")] : "No more than two foreign language courses without specific DUS approval" : 3;

SELECT 1 FROM LING 4900 : "Senior research requirement: LING 4900" : 1;
SELECT 1 FROM LING 4910 : "Senior essay and research colloquium (LING 4910)" : 1;
