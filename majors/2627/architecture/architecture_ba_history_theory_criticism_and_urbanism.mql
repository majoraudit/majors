// Architecture B.A. (History, Theory, Criticism of Architecture, and Urbanism concentration): fifteen course credits including the prerequisites and the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/architecture/
program architecture_ba_history_theory_criticism_and_urbanism {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact technology_orientation "Advanced technology workshop and materials laboratory orientation completed":
  approval dus_approval { for: "technology_orientation" };
fact library_orientation "Ninety-minute introductory library research session completed":
  approval dus_approval { for: "library_orientation" };
fact shop_orientation "Woodshop and materials lab orientation sessions completed":
  approval dus_approval { for: "shop_orientation" };
fact portfolio_submitted "Portfolio of design work, including prerequisites and the senior project, submitted to the DUS by the end of the spring term":
  approval dus_approval { for: "portfolio" };

requirement prereq_1001 "Prerequisite: ARCH 1001, by the end of sophomore year" [prerequisite] {
  slot from [ARCH 1001];
}

requirement prereq_2000 "Prerequisite: ARCH 2000, by the end of sophomore year" [prerequisite] {
  slot from [ARCH 2000];
}

requirement prereq_2600 "Prerequisite: ARCH 2600 or 2601, by the end of sophomore year" [prerequisite] {
  slot from [ARCH 2600, ARCH 2601];
}

requirement orientations "Orientation sessions: advanced technology, library, and shop" [orientation] {
  children exactly 3;
  requirement orientation_technology "Advanced technology orientation" { slot where attempt.approved_for contains "technology_orientation"; }
  requirement orientation_library "Library orientation" { slot where attempt.approved_for contains "library_orientation"; }
  requirement orientation_shop "Shop orientation" { slot where attempt.approved_for contains "shop_orientation"; }
}

effect technology_done when fact technology_orientation: waive orientation_technology;
effect library_done when fact library_orientation: waive orientation_library;
effect shop_done when fact shop_orientation: waive orientation_shop;

requirement surveys "Core: history of architecture surveys ARCH 2001 and 2003, by the end of junior year" [core] {
  courses exactly 2 from [ARCH 2001, ARCH 2003];
}

requirement studio_fall "Core: design studio ARCH 3000 (1.5 credits), fall of junior year" [core] {
  slot from [ARCH 3000];
}

requirement studio_spring "Core: a second design studio or urban laboratory (e.g. ARCH 3305, 3309) or an elective approved by the DUS, spring of junior year" [core] {
  slot where course.code in ["ARCH3001", "ARCH3305", "ARCH3309"] or attempt.approved_for contains "studio_spring";
}

requirement history_electives "Four electives in history and theory of architecture and the city, approved by the DUS" [elective] {
  courses at least 4 where course.attributes contains "YC ARCH History & Theory" or attempt.approved_for contains "history_electives";
}

requirement other_elective "One elective in urbanism and landscape, materials and design, or structures and computation, or another relevant course approved by the DUS" [elective] {
  slot where course.attributes contains "YC ARCH Urbanism & Landscape" or course.attributes contains "YC ARCH Materials & Design" or (course.attributes contains "YC ARCHStructures&Computation" or course.code in ["ARCH1400", "MATH1120", "MATH1150", "MATH1200", "PHYS1800", "PHYS2000"])
    or attempt.approved_for contains "other_elective";
}

requirement senior "Senior requirement: senior essay or project in ARCH 4900 (fall) and ARCH 4901 (spring)" [senior] {
  courses exactly 2 from [ARCH 4900, ARCH 4901];
}

requirement portfolio "Portfolio of design work submitted to the DUS" [senior] {
  slot where attempt.approved_for contains "portfolio";
}

effect portfolio_done when fact portfolio_submitted: waive portfolio;

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_credits "Fifteen course credits in all, including the prerequisites" in program:
  total at least 15 credits;
