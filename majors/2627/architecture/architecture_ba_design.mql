// Architecture B.A. -- Design concentration. 15 course credits including prerequisites and the senior requirement.
$histtheory = TAG("YC ARCH History & Theory");
$urbanism = TAG("YC ARCH Urbanism & Landscap");
$materials = TAG("YC ARCH Materials & Design");
$structures = [TAG("YC ARCH Structures & Computation"), ARCH 1400, MATH 1120, MATH 1150, MATH 1200, PHYS 1800, PHYS 2000];

SELECT 1 FROM ARCH 1001 : "Prerequisite: ARCH 1001" : 1;
SELECT 1 FROM ARCH 2000 : "Prerequisite: ARCH 2000" : 1;
SELECT 1 FROM [ARCH 2600, ARCH 2601] : "Prerequisite: ARCH 2600 or 2601" : 1;
SELECT 1 FROM PLACEMENT("Advanced technology, library, and shop orientation sessions completed") : "Required orientations" : 1;

SELECT 4 FROM [ARCH 3000, ARCH 3001, ARCH 2001, ARCH 2003] : "Core: junior studios ARCH 3000 and 3001; surveys ARCH 2001 and 2003" : 1;

SELECT 1 FROM [$histtheory, PLACEMENT("History/theory elective approved by the DUS")] : "Elective: history and theory of architecture and the city" : 2;
SELECT 1 FROM [$urbanism, PLACEMENT("Urbanism/landscape elective approved by the DUS")] : "Elective: urbanism and landscape" : 2;
SELECT 1 FROM [$materials, PLACEMENT("Materials/design elective approved by the DUS")] : "Elective: materials and design" : 2;
SELECT 1 FROM [$structures, PLACEMENT("Structures/computation elective approved by the DUS")] : "Elective: structures and computation" : 2;

SELECT 2 FROM [ARCH 4000, ARCH 4001] : "Senior requirement: ARCH 4000 and 4001" : 1;
