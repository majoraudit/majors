// Mechanical Engineering B.S. (ABET accredited) -- 20 courses (19.5 credits) beyond the prerequisites, including the senior requirement.
// The curriculum follows prescribed patterns; departures require DUS approval.
SELECT 3 FROM [SELECT 1 FROM [MATH 1120, PLACEMENT("Equivalent of MATH 1120")], SELECT 1 FROM [MATH 1150, PLACEMENT("Equivalent of MATH 1150")], SELECT 1 FROM [ENAS 1510, PLACEMENT("Equivalent of ENAS 1510")]] : "Prerequisite: MATH 1120, MATH 1150, and ENAS 1510 (or equivalents)" : 1;
SELECT 1 FROM [PHYS 1800, PHYS 2000, PHYS 2600, PLACEMENT("Equivalent physics lecture approved by the DUS")] : "Prerequisite: physics lecture (PHYS 1800, 2000, or 2600)" : 1;
SELECT 1 FROM [PHYS 1810, PHYS 2010, PHYS 2610, PLACEMENT("Equivalent physics lecture approved by the DUS")] : "Prerequisite: physics lecture (PHYS 1810, 2010, or 2610)" : 1;
SELECT 1 FROM [PHYS 1650L, PHYS 2050L, PLACEMENT("Equivalent physics laboratory approved by the DUS")] : "Prerequisite: physics laboratory (PHYS 1650L or 2050L)" : 1;
SELECT 1 FROM [PHYS 1660L, PHYS 2060L, PLACEMENT("Equivalent physics laboratory approved by the DUS")] : "Prerequisite: physics laboratory (PHYS 1660L or 2060L)" : 1;
SELECT 1 FROM [RANGE(CHEM 1610, CHEM 9999), PLACEMENT("Chemistry AP score of 4 or 5, or IB HL/SL score of 6 or 7")] : "Prerequisite: one-credit chemistry lecture numbered CHEM 1610 or higher" : 1;

SELECT 1 FROM ENAS 1940 : "Advanced mathematics: ENAS 1940" : 1;
SELECT 1 FROM [MATH 2220, MATH 2250] : "Advanced mathematics: MATH 2220 or 2250" : 1;
SELECT 2 FROM [ENAS 1300, ECE 2000] : "ENAS 1300 and ECE 2000" : 1;
SELECT 11 FROM [MENG 1105, MENG 2311, MENG 2511, MENG 2615, MENG 2616L, MENG 3020L, MENG 3125, MENG 3323, MENG 3422, MENG 3423L, MENG 3424] : "Mechanical engineering core" : 1;

$tech = TAG("YC MENG BS Technical Elective");
SELECT 3 FROM [$tech, $tech, $tech, SELECT 1 FROM [MENG 4991, MENG 4992], PLACEMENT("Technical elective approved by the DUS"), PLACEMENT("Technical elective approved by the DUS")] : "Three technical electives (at most one of MENG 4991 or 4992)" : 3;
LIMIT 1 FROM [MENG 4991, MENG 4992] : "At most one of MENG 4991 or 4992" : 3;

SELECT 2 FROM [MENG 4137L, MENG 4138L] : "Senior requirement: MENG 4137L and 4138L (senior year)" : 1;
