// Electrical Engineering B.S. (ABET accredited) -- 17 term courses beyond the prerequisites, including the senior requirement.
// Yale offers a single Electrical Engineering B.S., which is ABET accredited; this program follows that curriculum.
$elective = [CPSC 3650, CPSC 3660, MENG 3020L, MENG 2050, MENG 4673, BENG 4611, PHYS 4300, APHY 4580, RANGE(CPSC 4000, CPSC 9999), RANGE(ECE 4000, ECE 4679), RANGE(ECE 4692, ECE 9999), SELECT 1 FROM [ECE 4680, ECE 4691]];
$elective4 = [MENG 4673, BENG 4611, PHYS 4300, APHY 4580, RANGE(CPSC 4000, CPSC 9999), RANGE(ECE 4000, ECE 4679), RANGE(ECE 4692, ECE 9999), SELECT 1 FROM [ECE 4680, ECE 4691]];

SELECT 1 FROM [MATH 1120, PLACEMENT("Acceleration credit or placement beyond MATH 1120")] : "Prerequisite: MATH 1120 (if needed)" : 1;
SELECT 1 FROM [MATH 1150, PLACEMENT("Acceleration credit or placement beyond MATH 1150")] : "Prerequisite: MATH 1150 (if needed)" : 1;
SELECT 1 FROM [ENAS 1510, MATH 1200, MATH 2220, MATH 2250, MATH 2260, MATH 2550, MATH 2560] : "Prerequisite: ENAS 1510 or MATH 1200 or higher" : 1;
SELECT 1 FROM [ENAS 1300, CPSC 2010, PLACEMENT("More advanced programming course approved by the DUS (CPSC 1001 does not count)")] : "Prerequisite: ENAS 1300 or higher" : 1;
SELECT 1 FROM [SELECT 2 FROM [PHYS 1800, PHYS 1810], SELECT 2 FROM [PHYS 2000, PHYS 2010]] : "Prerequisite: PHYS 1800, 1810 or higher" : 1;

SELECT 1 FROM ENAS 1940 : "Mathematics: ENAS 1940" : 1;
SELECT 1 FROM [MATH 2220, MATH 2250, MATH 2260] : "Mathematics: linear algebra (MATH 2220, 2250, or 2260)" : 1;
SELECT 1 FROM [APHY 3220, PLACEMENT("Equivalent of APHY 3220 approved by the DUS")] : "Basic science: APHY 3220 or equivalent" : 1;
SELECT 1 FROM [S&DS 2380, S&DS 2410, PLACEMENT("Equivalent probability/statistics course approved by the DUS")] : "Basic science: S&DS 2380 or 2410 or equivalent" : 1;

SELECT 8 FROM [ECE 2000, ECE 2011, ECE 2020, ECE 2031, ECE 3101, ECE 3200, ECE 3250, ECE 3481] : "Electrical engineering core" : 1;

// Only one of ECE 4680 or 4691 (Pass/Fail) may count.
SELECT 4 FROM [$elective, $elective, $elective, $elective] : "Four engineering electives" : 3;
SELECT 3 FROM [$elective4, $elective4, $elective4] : "At least three engineering electives at the 4000 level or above" : 3;

SELECT 1 FROM ECE 4811 : "Senior requirement: ABET design project (ECE 4811)" : 1;
