// Electrical Engineering B.S. (ABET accredited): seventeen term courses beyond the prerequisites, including the senior requirement.
// Yale offers one Electrical Engineering B.S., which is ABET accredited; both manifest programs follow it.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/electrical-engineering/
// Each student's program must be approved by the DUS.
program electrical_engineering_bs_abet {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact calculus_1120_placement "Acceleration credit or placement beyond MATH 1120": placement { test: "Yale mathematics placement", result: "beyond MATH 1120" };
fact calculus_1150_placement "Acceleration credit or placement beyond MATH 1150": placement { test: "Yale mathematics placement", result: "beyond MATH 1150" };

requirement prereq_1120 "Prerequisite: MATH 1120, if needed" [prerequisite] {
  slot from [MATH 1120];
}

requirement prereq_1150 "Prerequisite: MATH 1150, if needed" [prerequisite] {
  slot from [MATH 1150];
}

effect placed_1120 when fact calculus_1120_placement: waive prereq_1120;
effect placed_1150 when fact calculus_1150_placement: waive prereq_1150;

requirement prereq_multivariable "Prerequisite: ENAS 1510 or MATH 1200 or higher" [prerequisite] {
  slot where course.code in ["ENAS1510", "MATH1200"] or course.subject = "MATH" and course.number >= 2220;
}

requirement prereq_programming "Prerequisite: ENAS 1300 or higher (CPSC 1001 does not count)" [prerequisite] {
  slot where course.code in ["ENAS1300", "CPSC2010"] or attempt.approved_for contains "prereq_programming";
}

requirement prereq_physics "Prerequisite: PHYS 1800 and 1810 or higher" [prerequisite] {
  courses at least 2 where course.code in ["PHYS1800", "PHYS1810", "PHYS2000", "PHYS2010"];
}

requirement differential_equations "Mathematics: ENAS 1940" [core] {
  slot from [ENAS 1940];
}

requirement linear_algebra "Mathematics: MATH 2220, 2250, or 2260" [core] {
  slot from [MATH 2220, MATH 2250, MATH 2260];
}

requirement electromagnetism "Basic science: APHY 3220 or an equivalent" [core] {
  slot where course.code = "APHY3220" or attempt.approved_for contains "electromagnetism";
}

requirement probability "Basic science: S&DS 2380 or 2410, or an equivalent" [core] {
  slot where course.code in ["S&DS2380", "S&DS2410"] or attempt.approved_for contains "probability";
}

requirement ece_core "Electrical engineering: ECE 2000, 2011, 2020, 2031, 3101, 3200, 3250, and 3481" [core] {
  courses exactly 8 from [ECE 2000, ECE 2011, ECE 2020, ECE 2031, ECE 3101, ECE 3200, ECE 3250, ECE 3481];
}

requirement electives "Four engineering electives, at least three at the 4000 level or above" [elective] {
  courses at least 4
    where course.code in ["CPSC3650", "CPSC3660", "MENG3020L", "MENG2050", "MENG4673", "BENG4611", "PHYS4300", "APHY4580"]
      or course.subject in ["CPSC", "ECE"] and course.number >= 4000;
  constraint advanced_electives "At least three at the 4000 level or above": at least 3 attempts where course.code in ["MENG4673", "BENG4611", "PHYS4300", "APHY4580"] or course.subject in ["CPSC", "ECE"] and course.number >= 4000;
}

requirement senior "Senior requirement: ABET design project (ECE 4811)" [senior] {
  slot from [ECE 4811];
}

constraint ece_2031_order "ECE 2031 requires ECE 2000 first" in program:
  order course.code = "ECE2000" before course.code = "ECE2031";

constraint one_special_project "Only one of ECE 4680 or 4691 (Pass/Fail) counts toward the major" in program:
  limit 1 attempts where course.code in ["ECE4680", "ECE4691"];

constraint no_crdf "No course taken Credit/D/Fail counts, including prerequisites" in program:
  all where attempt.grading_mode != "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_courses "Seventeen term courses beyond the prerequisites" in roles [core, elective, senior]:
  total at least 17 attempts;
