// Russian, East European, and Eurasian Studies B.A. -- East European Studies or Eurasian Studies concentration.
// 11 term courses including the senior requirement.
$lang = [RANGE(CZEC 0000, CZEC 9999), RANGE(PLSH 0000, PLSH 9999), RANGE(ROMN 0000, ROMN 9999), RANGE(SBCR 0000, SBCR 9999), RANGE(HGRN 0000, HGRN 9999), RANGE(UKRN 0000, UKRN 9999), RANGE(TKSH 0000, TKSH 9999), PLACEMENT("East European or Eurasian language through the Shared Course Initiative")];
SELECT 2 FROM [$lang, $lang, PLACEMENT("Placement examination in an East European or Eurasian language")] : "Prerequisite: two semesters of first-year East European or Eurasian language" : 1;
$rsee = [RANGE(RSEE 0000, RSEE 4899), RANGE(RSEE 4911, RSEE 9999)];
$area = PLACEMENT("Russian, East European, or Eurasian area course approved by the DUS");

SELECT 2 FROM [TAG("YC HIST Europe"), TAG("YC HIST Europe"), $area, $area] : "Two courses in Russian, East European, or Eurasian history" : 2;
SELECT 1 FROM [PLACEMENT("RSEE-area focused social science course (anthropology, economics, sociology, political science, global affairs, etc.)")] : "One RSEE-area social science course" : 2;
SELECT 1 FROM [RANGE(RUSS 0001, RUSS 0999), RANGE(RUSS 2000, RUSS 4899), PLACEMENT("Russian, East European, or Eurasian literature or culture course selected with the DUS")] : "One course in Russian, East European, or Eurasian literature or culture" : 2;
SELECT 4 FROM [$lang, $lang, $lang, $lang, PLACEMENT("Third-year proficiency by equivalency examination (replace with additional courses)")] : "Language: third-year level (four term courses) in an East European or Eurasian language" : 1;
SELECT 2 FROM [$rsee, $rsee, $area, $area] : "Two electives chosen with the DUS" : 4;

// Only one of RSEE 4900 and 4910 counts, except as an extra course for double majors.
SELECT 1 FROM [RSEE 4900, RSEE 4910] : "Senior essay (RSEE 4900 or 4910)" : 1;
