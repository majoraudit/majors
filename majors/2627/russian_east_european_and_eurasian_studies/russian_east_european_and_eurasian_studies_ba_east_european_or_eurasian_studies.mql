// Russian, East European, and Eurasian Studies B.A. (East European Studies or Eurasian Studies concentration): eleven term courses
// including the senior requirement but not the prerequisites.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/russian-east-european-eurasian-studies/
program russian_east_european_and_eurasian_studies_ba_east_european_or_eurasian_studies {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact language_placement "First-year East European or Eurasian language completed by placement examination":
  placement { test: "East European or Eurasian language placement", result: "first year" };
fact language_equivalency "Third-year proficiency shown by an equivalency examination":
  language_proficiency { language: "East European or Eurasian language", level: "third year" };

requirement prereq "Prerequisite: two semesters of a first-year East European or Eurasian language (or the Shared Course Initiative)" [prerequisite] {
  courses at least 2 where course.subject in ["CZEC", "PLSH", "ROMN", "SBCR", "HGRN", "UKRN", "TKSH"] or attempt.approved_for contains "prereq";
}

effect placed when fact language_placement: waive prereq;

requirement language "Language: four term courses completing the third-year level in one East European or Eurasian language" [language] {
  courses at least 4 where course.subject in ["CZEC", "PLSH", "ROMN", "SBCR", "HGRN", "UKRN", "TKSH"] or attempt.approved_for contains "language";
  constraint one_language "In the chosen language": group course.subject same;
}

effect equivalency when fact language_equivalency: waive language;

requirement history "Two courses in Russian, East European, or Eurasian history" [core] {
  courses at least 2 where attempt.approved_for contains "history";
}

requirement social_science "One RSEE-area focused course in the social sciences (anthropology, economics, sociology, political science, global affairs, and others), with DUS approval" [core] {
  slot where attempt.approved_for contains "social_science";
}

requirement literature "One course in Russian, East European, or Eurasian literature or culture, selected with the DUS" [core] {
  slot where course.subject = "RUSS" and (course.number <= 999 or course.number >= 2000 and course.number <= 4899)
    or attempt.approved_for contains "literature";
}

requirement electives "Electives chosen with the DUS to reach eleven courses" [elective] {
  courses at least 0
    where course.subject = "RSEE" and not course.code in ["RSEE4900", "RSEE4910"] or attempt.approved_for contains "electives";
}

// Only one of RSEE 4900 and 4910 counts, except as an extra course for students in two majors.
requirement senior "Senior essay: RSEE 4900 or 4910" [senior] {
  slot from [RSEE 4900, RSEE 4910];
}

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Eleven term courses including the senior requirement" in roles [language, core, elective, senior]:
  total at least 11 attempts;
