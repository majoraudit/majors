// Computing and the Arts B.A. -- Theater, Dance, and Performance Studies concentration. 12 term courses beyond the prerequisites (6 CPSC, 6 in the arts), plus the two-term senior project.

SELECT 2 FROM [TDPS 1000, TDPS 1001] : "Prerequisite: TDPS 1000 and TDPS 1001" : 1;

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 1 FROM CPSC 2230 : "CPSC 2230" : 1;
SELECT 1 FROM [CPSC 4310, CPSC 4320] : "CPSC 4310 or 4320" : 2;
SELECT 1 FROM [CPSC 4780, CPSC 4790, CPSC 4840] : "CPSC 4780, 4790, or 4840" : 2;
SELECT 1 FROM [TAG("YC CPAR THST CS Elective"), RANGE(CPSC 2000, CPSC 4899), RANGE(CPSC 4901, CPSC 9999)] : "One additional intermediate or advanced CPSC course (not CPSC 4900)" : 3;

SELECT 1 FROM TAG("YC TDPS Artistic Practice") : "TDPS domain: Artistic Practice" : 2;
SELECT 1 FROM TAG("YC TDPS Histories") : "TDPS domain: Histories" : 2;
SELECT 1 FROM TAG("YC TDPS Performance Theory") : "TDPS domain: Performance Theory" : 2;
SELECT 1 FROM TAG("YC TDPS Interarts") : "TDPS domain: Interarts" : 2;
$domain = [TAG("YC TDPS Artistic Practice"), TAG("YC TDPS Histories"), TAG("YC TDPS Performance Theory"), TAG("YC TDPS Interarts")];
SELECT 2 FROM [$domain, $domain] : "Two additional TDPS courses in any domain" : 3;

SELECT 2 FROM [CPSC 4900, SELECT 1 FROM [TDPS 4701, RANGE(TDPS 4900, TDPS 4902)]] : "Two-term senior project (CPSC 4900 and TDPS 4701 or one of TDPS 4900-4902)" : 1;
