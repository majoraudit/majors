// Computing and the Arts B.A. -- Art concentration. 12 term courses beyond the prerequisites (6 CPSC, 6 in the arts), plus the two-term senior project.

SELECT 2 FROM [ART 1111, ART 1514] : "Prerequisite: ART 1111 and ART 1514" : 1;
SELECT 1 FROM PLACEMENT("Sophomore review at the School of Art") : "Prerequisite: sophomore review" : 1;

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 1 FROM CPSC 2230 : "CPSC 2230" : 1;
SELECT 2 FROM [CPSC 3760, CPSC 4370, CPSC 4460, CPSC 4510, CPSC 4750, CPSC 4780, CPSC 4790, CPSC 4840] : "Two computer graphics/visualization courses" : 2;
SELECT 1 FROM [TAG("YC CPAR ART CS Elective"), RANGE(CPSC 2000, CPSC 4899), RANGE(CPSC 4901, CPSC 9999)] : "One additional intermediate or advanced CPSC course (not CPSC 4900)" : 3;

SELECT 2 FROM [RANGE(ART 1000, ART 1110), RANGE(ART 1000, ART 1110), RANGE(ART 1112, ART 1513), RANGE(ART 1112, ART 1513), RANGE(ART 1515, ART 1999), RANGE(ART 1515, ART 1999)] : "Two 1000-level Art courses beyond ART 1111 and 1514" : 2;
SELECT 2 FROM [RANGE(ART 2000, ART 3994), RANGE(ART 2000, ART 3994), RANGE(ART 3996, ART 3999)] : "Two Art courses at the 2000 or 3000 level" : 2;
SELECT 2 FROM [ART 3995, ART 4995] : "ART 3995 and ART 4995" : 1;

SELECT 2 FROM [CPSC 4900, ART 4996] : "Two-term senior project (CPSC 4900 and ART 4996)" : 1;
