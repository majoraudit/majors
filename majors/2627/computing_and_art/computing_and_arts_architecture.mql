// Computing and the Arts B.A. -- Architecture concentration. 12 term courses beyond the prerequisites (6 CPSC, 6 in the arts), plus the two-term senior project.

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 1 FROM CPSC 2230 : "CPSC 2230" : 1;
SELECT 2 FROM [CPSC 3760, CPSC 4370, CPSC 4460, CPSC 4510, CPSC 4750, CPSC 4780, CPSC 4790, CPSC 4840] : "Two computer graphics/visualization courses" : 2;
SELECT 1 FROM [TAG("YC CPAR ARCH CS Elective"), RANGE(CPSC 2000, CPSC 4899), RANGE(CPSC 4901, CPSC 9999)] : "One additional intermediate or advanced CPSC course (not CPSC 4900)" : 3;

SELECT 2 FROM [ARCH 1001, ARCH 2000] : "ARCH 1001 and ARCH 2000" : 1;
SELECT 2 FROM [ARCH 2001, ARCH 2003, ARCH 3304, ARCH 3305] : "Two of ARCH 2001, 2003, 3304, 3305" : 2;
SELECT 2 FROM [TAG("YC ARCH History & Theory"), TAG("YC ARCH History & Theory"), TAG("YC ARCH Urbanism & Landscap"), TAG("YC ARCH Urbanism & Landscap"), TAG("YC ARCH Materials & Design"), TAG("YC ARCH Materials & Design"), TAG("YC ARCH Structures & Computation"), TAG("YC ARCH Structures & Computation")] : "Two electives from the Architecture Design or History, Theory, Criticism, and Urbanism concentrations" : 3;

SELECT 2 FROM [CPSC 4900, ARCH 4901] : "Two-term senior project (CPSC 4900 and ARCH 4901)" : 1;
