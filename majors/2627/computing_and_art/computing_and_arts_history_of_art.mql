// Computing and the Arts B.A. -- History of Art concentration. 12 term courses beyond the prerequisites (6 CPSC, 6 in the arts), plus the two-term senior project.

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 1 FROM CPSC 2230 : "CPSC 2230" : 1;
SELECT 1 FROM [CPSC 4780, CPSC 4790] : "CPSC 4780 or 4790" : 2;
SELECT 1 FROM [CPSC 3760, CPSC 4370, CPSC 4510, CPSC 4750, CPSC 4780, CPSC 4790] : "One more of CPSC 3760, 4370, 4510, 4750, 4780, 4790" : 2;
SELECT 1 FROM [TAG("YC CPAR HSAR CS Elective"), RANGE(CPSC 2000, CPSC 4899), RANGE(CPSC 4901, CPSC 9999)] : "One additional intermediate or advanced CPSC course (not CPSC 4900)" : 3;

SELECT 1 FROM [RANGE(HSAR 1000, HSAR 1999)] : "Introductory 1000-level History of Art course" : 2;
SELECT 2 FROM [
    SELECT 1 FROM [RANGE_TAG(HSAR 2000, HSAR 4999, "YC HSAR Africa & Pacific")],
    SELECT 1 FROM [RANGE_TAG(HSAR 2000, HSAR 4999, "YC HSAR Asia & Near East")],
    SELECT 1 FROM [RANGE_TAG(HSAR 2000, HSAR 4999, "YC HSAR Europe")],
    SELECT 1 FROM [RANGE_TAG(HSAR 2000, HSAR 4999, "YC HSAR The Americas")],
    SELECT 1 FROM [RANGE_TAG(HSAR 2000, HSAR 4999, "YC HSAR Transregional")]
] : "Two History of Art courses (2000-4000 level) in two different areas" : 2;
SELECT 1 FROM [RANGE(ART 0000, ART 9999)] : "One studio art course" : 2;
SELECT 1 FROM HSAR 4401 : "HSAR 4401" : 1;
SELECT 1 FROM [RANGE(HSAR 4000, HSAR 4400), RANGE(HSAR 4402, HSAR 4498)] : "One 4000-level seminar in History of Art" : 2;

SELECT 2 FROM [CPSC 4900, HSAR 4499] : "Two-term senior project (CPSC 4900 and HSAR 4499)" : 1;
