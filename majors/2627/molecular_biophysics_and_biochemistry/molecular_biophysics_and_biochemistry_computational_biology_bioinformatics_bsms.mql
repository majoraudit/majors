// Molecular Biophysics and Biochemistry simultaneous B.S./M.S. (Computational Biology and Bioinformatics concentration): 12.5 course credits beyond the
// introductory courses, including the senior requirement, plus the graduate requirements of the M.S..
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/molecular-biophysics-biochemistry/
program molecular_biophysics_and_biochemistry_computational_biology_bioinformatics_bsms {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement intro_biology "Introductory: BIOL 1010 and 1020" [introductory] {
  courses exactly 2 from [BIOL 1010, BIOL 1020];
}

requirement intro_chemistry "Introductory: two terms of general chemistry with laboratories" [introductory] {
  children at least 1;
  requirement intro_chem_1610 "CHEM 1610, 1650, 1340L, and 1360L" { courses exactly 4 from [CHEM 1610, CHEM 1650, CHEM 1340L, CHEM 1360L]; }
  requirement intro_chem_1630 "CHEM 1630, 1670, 1340L, and 1360L" { courses exactly 4 from [CHEM 1630, CHEM 1670, CHEM 1340L, CHEM 1360L]; }
}

requirement intro_organic "Introductory: one term of organic chemistry (CHEM 2200 or 1740) with laboratory (CHEM 2220L)" [introductory] {
  children exactly 2;
  requirement intro_organic_lecture "CHEM 2200 or 1740" { slot from [CHEM 2200, CHEM 1740]; }
  requirement intro_organic_lab "CHEM 2220L" { slot from [CHEM 2220L]; }
}

requirement intro_calculus "Introductory: two terms of calculus (MATH 1120 and 1150, or MATH 1160)" [introductory] {
  children at least 1;
  requirement intro_calc_two "MATH 1120 and 1150" { courses exactly 2 from [MATH 1120, MATH 1150]; }
  requirement intro_calc_1160 "MATH 1160" { slot from [MATH 1160]; }
}

requirement physics "Biophysics: two semesters of physics (PHYS 1700 and 1710 or higher)" [core] {
  courses at least 2 from [PHYS 1700, PHYS 1710, PHYS 1800, PHYS 1810, PHYS 2000, PHYS 2010, PHYS 2600, PHYS 2610];
}

requirement biophysical_chemistry "Biophysics: biophysical chemistry (MB&B 2750 or CHEM 3320)" [core] {
  slot from [MB&B 2750, CHEM 3320];
}

requirement biophysics_advanced "Biophysics (B.S.): one additional 3000+ course in the physical sciences, mathematics, statistics, or computer science" [core] {
  slot where course.subject in ["PHYS", "CHEM", "MATH", "S&DS", "CPSC", "APHY", "MB&B"] and course.number >= 3000
    or attempt.approved_for contains "biophysics_advanced";
}

requirement biochemistry "Biochemistry: MB&B 3000 and 3010 (no substitutions)" [core] {
  courses exactly 2 from [MB&B 3000, MB&B 3010];
}

requirement chemistry_elective "Biochemistry: CHEM 1750 or any Chemistry course numbered 2000 or above" [core] {
  slot where course.code = "CHEM1750" or course.subject = "CHEM" and course.number >= 2000;
}

requirement science_society "Science and society, half credit (MB&B 2680 recommended; alternatives listed or by petition)" [core] {
  slot where course.code in ["MB&B2680", "MB&B1070", "BLST1370", "HSHM2060", "HSHM4060", "HSHM4240", "HSHM4750", "HSHM4810", "HIST1779", "SOCY1600", "SOCY1601", "SOCY3760", "MCDB3750", "WGSS2270", "WGSS4457"]
    or attempt.approved_for contains "science_society";
}

// MB&B 4700 (research for credit) counts in whichever category its project fits, recorded as an approval.
requirement skills "Practical skills: two credits across two or three categories, at least a half-credit from MB&B" [core] {
  children at least 2;
  requirement skills_physics_lab "Physics lab" {
    credits at least 0.5 where course.code in ["MB&B1210L", "MB&B1220L", "MB&B1230L", "MB&B1240L", "PHYS1650L", "PHYS1660L", "CHEM3550L"]
      or attempt.approved_for contains "skills_physics_lab";
  }
  requirement skills_biochemistry_lab "Biochemistry lab" {
    credits at least 0.5 where course.code in ["MB&B2510L", "CHEM3550L"] or attempt.approved_for contains "skills_biochemistry_lab";
  }
  requirement skills_tools "Critical tools" {
    credits at least 0.5 where course.code in ["MB&B4350", "S&DS2380", "CPSC1001"] or attempt.approved_for contains "skills_tools";
  }
  constraint skills_credits "Two credits in all" in subtree skills: total at least 2 credits;
  constraint skills_mbb "At least a half-credit from MB&B" in subtree skills: at least 0.5 credits where course.subject = "MB&B";
}

requirement mbb_elective "Elective: an MB&B lecture or seminar at the 2000+ level" [elective] {
  slot where course.subject = "MB&B" and course.number >= 2000 and course.format in ["lecture", "seminar"];
}

requirement stem_elective "Elective (B.S.): one additional 2000+ seminar or lecture course in STEM" [elective] {
  slot where course.subject in ["MB&B", "CHEM", "MCDB", "BIOL", "PHYS", "MATH", "S&DS", "CPSC", "EEB", "E&EB", "EPS", "BENG", "APHY"] and course.number >= 2000 and course.format in ["lecture", "seminar"]
    or attempt.approved_for contains "stem_elective";
}

requirement senior "Senior essay: a literature project (MB&B 4900) or a laboratory research essay (MB&B 4910)" [senior] {
  slot from [MB&B 4900, MB&B 4910];
}

// Concentration courses may also satisfy major requirements (pairwise sharing below); placement and
// acceleration credit do not count toward them. The concentration adds zero to three credits.

requirement conc_advanced "Computational Biology and Bioinformatics: Advanced computational biology course (MB&B 3520, CPSC 4530, or approved)" [concentration] {
  slot where course.code in ["MB&B3520", "CPSC4530"] or attempt.approved_for contains "conc_advanced";
}

requirement conc_genetics "Computational Biology and Bioinformatics: Genetics and evolutionary biology (MCDB 2000, 2020, 3100, MB&B 3310, or an approved 2000+ elective)" [concentration] {
  slot where course.code in ["MCDB2000", "MCDB2020", "MCDB3100", "MB&B3310"] or attempt.approved_for contains "conc_genetics";
}

requirement conc_computing "Computational Biology and Bioinformatics: CPSC 2230, CPSC 2010, and S&DS 2380" [concentration] {
  courses exactly 3 from [CPSC 2230, CPSC 2010, S&DS 2380];
}

share conc_advanced_with_intro_biology: conc_advanced, intro_biology;
share conc_advanced_with_intro_chem_1610: conc_advanced, intro_chem_1610;
share conc_advanced_with_intro_chem_1630: conc_advanced, intro_chem_1630;
share conc_advanced_with_intro_organic_lecture: conc_advanced, intro_organic_lecture;
share conc_advanced_with_intro_organic_lab: conc_advanced, intro_organic_lab;
share conc_advanced_with_intro_calc_two: conc_advanced, intro_calc_two;
share conc_advanced_with_intro_calc_1160: conc_advanced, intro_calc_1160;
share conc_advanced_with_physics: conc_advanced, physics;
share conc_advanced_with_biophysical_chemistry: conc_advanced, biophysical_chemistry;
share conc_advanced_with_biophysics_advanced: conc_advanced, biophysics_advanced;
share conc_advanced_with_biochemistry: conc_advanced, biochemistry;
share conc_advanced_with_chemistry_elective: conc_advanced, chemistry_elective;
share conc_advanced_with_science_society: conc_advanced, science_society;
share conc_advanced_with_skills_physics_lab: conc_advanced, skills_physics_lab;
share conc_advanced_with_skills_biochemistry_lab: conc_advanced, skills_biochemistry_lab;
share conc_advanced_with_skills_tools: conc_advanced, skills_tools;
share conc_advanced_with_mbb_elective: conc_advanced, mbb_elective;
share conc_advanced_with_stem_elective: conc_advanced, stem_elective;
share conc_genetics_with_intro_biology: conc_genetics, intro_biology;
share conc_genetics_with_intro_chem_1610: conc_genetics, intro_chem_1610;
share conc_genetics_with_intro_chem_1630: conc_genetics, intro_chem_1630;
share conc_genetics_with_intro_organic_lecture: conc_genetics, intro_organic_lecture;
share conc_genetics_with_intro_organic_lab: conc_genetics, intro_organic_lab;
share conc_genetics_with_intro_calc_two: conc_genetics, intro_calc_two;
share conc_genetics_with_intro_calc_1160: conc_genetics, intro_calc_1160;
share conc_genetics_with_physics: conc_genetics, physics;
share conc_genetics_with_biophysical_chemistry: conc_genetics, biophysical_chemistry;
share conc_genetics_with_biophysics_advanced: conc_genetics, biophysics_advanced;
share conc_genetics_with_biochemistry: conc_genetics, biochemistry;
share conc_genetics_with_chemistry_elective: conc_genetics, chemistry_elective;
share conc_genetics_with_science_society: conc_genetics, science_society;
share conc_genetics_with_skills_physics_lab: conc_genetics, skills_physics_lab;
share conc_genetics_with_skills_biochemistry_lab: conc_genetics, skills_biochemistry_lab;
share conc_genetics_with_skills_tools: conc_genetics, skills_tools;
share conc_genetics_with_mbb_elective: conc_genetics, mbb_elective;
share conc_genetics_with_stem_elective: conc_genetics, stem_elective;
share conc_computing_with_intro_biology: conc_computing, intro_biology;
share conc_computing_with_intro_chem_1610: conc_computing, intro_chem_1610;
share conc_computing_with_intro_chem_1630: conc_computing, intro_chem_1630;
share conc_computing_with_intro_organic_lecture: conc_computing, intro_organic_lecture;
share conc_computing_with_intro_organic_lab: conc_computing, intro_organic_lab;
share conc_computing_with_intro_calc_two: conc_computing, intro_calc_two;
share conc_computing_with_intro_calc_1160: conc_computing, intro_calc_1160;
share conc_computing_with_physics: conc_computing, physics;
share conc_computing_with_biophysical_chemistry: conc_computing, biophysical_chemistry;
share conc_computing_with_biophysics_advanced: conc_computing, biophysics_advanced;
share conc_computing_with_biochemistry: conc_computing, biochemistry;
share conc_computing_with_chemistry_elective: conc_computing, chemistry_elective;
share conc_computing_with_science_society: conc_computing, science_society;
share conc_computing_with_skills_physics_lab: conc_computing, skills_physics_lab;
share conc_computing_with_skills_biochemistry_lab: conc_computing, skills_biochemistry_lab;
share conc_computing_with_skills_tools: conc_computing, skills_tools;
share conc_computing_with_mbb_elective: conc_computing, mbb_elective;
share conc_computing_with_stem_elective: conc_computing, stem_elective;

constraint concentration_no_acceleration "Placement and acceleration credit do not count toward concentration requirements" in roles [concentration]:
  all where attempt.source != "acceleration";

constraint research_letter "Up to two credits of MB&B 4700 may be taken for a letter grade" in program:
  limit 2 credits where course.code = "MB&B4700" and attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_credits "12.5 course credits beyond the introductory courses, including the senior requirement" in roles [core, elective, senior]:
  total at least 12.5 credits;

fact ms_admission "Admitted to the simultaneous B.S./M.S. by the DUS and DGS (application by the end of the fifth term)":
  approval committee_approval { for: "ms_admission" };

requirement admission "Admission to the simultaneous B.S./M.S. program" [graduate] {
  slot where attempt.approved_for contains "ms_admission";
}

effect admitted when fact ms_admission: waive admission;

requirement graduate_mbb "M.S.: two graduate MB&B courses" [graduate] {
  courses at least 2 where course.subject = "MB&B" and course.number >= 5000;
}

requirement graduate_stem "M.S.: four additional graduate STEM courses approved by the DUS and DGS" [graduate] {
  courses at least 4
    where course.subject in ["MB&B", "CHEM", "MCDB", "PHYS", "BENG", "CPSC", "S&DS"] and course.number >= 5000
      or attempt.approved_for contains "graduate_stem";
}

constraint graduate_grades "Graduate courses earn Honors, High Pass, or Pass" in roles [graduate]:
  all where attempt.graduate_grade in ["H", "HP", "P"];

constraint graduate_honors "At least two grades of Honors" in roles [graduate]:
  at least 2 attempts where attempt.graduate_grade = "H";

advisory requirement graduate_average "All graduate grades must average High Pass" [graduate] {
  slot where attempt.approved_for contains "graduate_average";
}
