share conc_research_with_mbb_elective: conc_research, mbb_elective;
share conc_research_with_stem_elective: conc_research, stem_elective;
share conc_advanced_with_intro_biology: conc_advanced, intro_biology;
share conc_advanced_with_intro_chem_1610: conc_advanced, intro_chem_1610;
share conc_advanced_with_intro_chem_1630: conc_advanced, intro_chem_1630;
share conc_advanced_with_intro_organic_lecture: conc_advanced, intro_organic_lecture;
share conc_advanced_with_intro_organic_lab: conc_advanced, intro_organic_lab;
share conc_advanced_with_intro_calc_two: conc_advanced, intro_calc_two;
share conc_advanced_with_intro_calc_1160: conc_advanced, intro_calc_1160;
share conc_advanced_with_physics: conc_advanced, physics;
share conc_advanced_with_biophysical_chemistry: conc_advanced, biophysical_chemistry;
share conc_advanced_with_biophysics_advanced: conc_advanced, biophysics_advanced;
share conc_advanced_with_biochemistry: conc_advanced, biochemistry;
