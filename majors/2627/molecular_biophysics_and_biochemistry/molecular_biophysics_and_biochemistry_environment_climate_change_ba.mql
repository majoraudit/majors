constraint concentration_no_acceleration "Placement and acceleration credit do not count toward concentration requirements" in roles [concentration]:
  all where attempt.source != "acceleration";

constraint research_letter "Up to two credits of MB&B 4700 may be taken for a letter grade" in program:
  limit 2 credits where course.code = "MB&B4700" and attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_credits "9.5 course credits beyond the introductory courses, including the senior requirement" in roles [core, elective, senior]:
  total at least 9.5 credits;
