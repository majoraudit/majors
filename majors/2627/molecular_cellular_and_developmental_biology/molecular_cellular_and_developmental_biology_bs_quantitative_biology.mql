// Molecular, Cellular, and Developmental Biology B.S. (Quantitative Biology concentration): at least 9 course credits
// beyond the prerequisites, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/molecular-cellular-developmental-biology/
// A course cannot satisfy both a prerequisite and a core or elective requirement (the exclusive default).
// Research courses MCDB 4750, 4850, 4860, 4950, and 4960 count only toward the senior requirement; MCDB 4740 never counts.
program molecular_cellular_and_developmental_biology_bs_quantitative_biology {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact biology_two_modules "Placed out of two BIOL modules (placement exam with AP Biology 5, or DUS permission)":
  placement { test: "BIOL placement", result: "two modules" };
fact biology_four_modules "Placed out of all four BIOL modules (placement exam with AP Biology 5, or DUS permission)":
  placement { test: "BIOL placement", result: "four modules" };
fact chemistry_placement "Placed out of the chemistry prerequisite": placement { test: "Chemistry placement", result: "pass" };
fact physics_placement "Placed out of the physics prerequisite": placement { test: "Physics placement", result: "pass" };

requirement prereq_biology "Prerequisite: BIOL 1010, 1020, 1030, and 1040" [prerequisite] {
  courses exactly 4 from [BIOL 1010, BIOL 1020, BIOL 1030, BIOL 1040];
}

effect biology_two_placed "Two modules placed out reduce the biology prerequisite to two" when fact biology_two_modules:
  set lower of prereq_biology to 2;
effect biology_four_placed when fact biology_four_modules: waive prereq_biology;

// Every two BIOL modules placed out are replaced by one MCDB core course or MCDB lecture or seminar numbered 2000 or above.
requirement biology_substitute_one "One MCDB core or 2000+ MCDB lecture or seminar in place of two BIOL modules" [prerequisite]
    when fact biology_two_modules {
  slot where course.subject = "MCDB" and course.number >= 2000 and course.format in ["lecture", "seminar"];
}

requirement biology_substitute_two "Two MCDB core or 2000+ MCDB lectures or seminars in place of four BIOL modules" [prerequisite]
    when fact biology_four_modules {
  courses at least 2 where course.subject = "MCDB" and course.number >= 2000 and course.format in ["lecture", "seminar"];
}

requirement prereq_math "Prerequisite: MATH 1150 or above, or a Yale statistics course approved by the DUS (not S&DS 1600)" [prerequisite] {
  slot where course.subject = "MATH" and course.number >= 1150
    or course.code in ["S&DS1000", "S&DS1080", "S&DS1090", "S&DS2380"] or attempt.approved_for contains "prereq_math";
}

requirement prereq_chemistry "Prerequisite: a two-term lecture sequence in chemistry with associated labs" [prerequisite] {
  children at least 1;
  requirement prereq_chem_1610 "CHEM 1610, 1650, 1340L, and 1360L" { courses exactly 4 from [CHEM 1610, CHEM 1650, CHEM 1340L, CHEM 1360L]; }
  requirement prereq_chem_1700 "CHEM 1700 and 1710L" { courses exactly 2 from [CHEM 1700, CHEM 1710L]; }
}

requirement prereq_organic "Prerequisite: one organic chemistry course with associated lab" [prerequisite] {
  children exactly 2;
  requirement prereq_organic_lecture "CHEM 1740, 1750, or 2200" { slot from [CHEM 1740, CHEM 1750, CHEM 2200]; }
  requirement prereq_organic_lab "CHEM 2220L or 2230L" { slot from [CHEM 2220L, CHEM 2230L]; }
}

effect organic_placed when fact chemistry_placement: waive prereq_organic;

requirement prereq_physics "Prerequisite: two physics courses, PHYS 1700 or above" [prerequisite] {
  children at least 1;
  requirement prereq_physics_1700 "PHYS 1700 and 1710" { courses exactly 2 from [PHYS 1700, PHYS 1710]; }
  requirement prereq_physics_1800 "PHYS 1800 and 1810" { courses exactly 2 from [PHYS 1800, PHYS 1810]; }
  requirement prereq_physics_2000 "PHYS 2000 and 2010" { courses exactly 2 from [PHYS 2000, PHYS 2010]; }
  requirement prereq_physics_2600 "PHYS 2600 and 2610" { courses exactly 2 from [PHYS 2600, PHYS 2610]; }
}

effect chemistry_placed when fact chemistry_placement: waive prereq_chemistry;
effect physics_placed when fact physics_placement: waive prereq_physics;

requirement core "Three core courses: MCDB 2000, 2020, 2050, 2100, 2900, 3000, or MB&B 3000" [core] {
  courses at least 3 where course.code in ["MCDB2000", "MCDB2020", "MCDB2050", "MCDB2100", "MCDB2900", "MCDB3000", "MB&B3000"];
}

// MCDB 3420L with 3430L, or 3440L with 3450L, pair for a single elective credit.
requirement general_electives "Two general electives: MCDB 2500 or above, additional core courses, a second term of organic chemistry, a statistics course, or paired labs, or concentration-related electives" [elective] {
  credits at least 2
    where course.subject = "MCDB" and course.number >= 2500 and not course.code in ["MCDB4740", "MCDB4750", "MCDB4850", "MCDB4860", "MCDB4950", "MCDB4960"]
      or course.code in ["MCDB2000", "MCDB2020", "MCDB2050", "MCDB2100", "MCDB2900", "MCDB3000", "MB&B3000"]
      or course.code in ["MCDB3420L", "MCDB3430L", "MCDB3440L", "MCDB3450L"]
      or course.code in ["CHEM1750", "CHEM2210"] or course.subject = "S&DS"
      or course.code in ["BENG4630", "BENG4767", "CPSC4750", "MATH2460", "MATH2510", "MB&B3520", "MB&B4350", "MB&B5230", "MCDB3200", "MCDB3620"]
      or attempt.approved_for contains "general_electives";
}

requirement special_elective "One special elective: an MCDB course numbered 3500 or above (or a concentration-related elective)" [elective] {
  slot where course.subject = "MCDB" and course.number >= 3500 and not course.code in ["MCDB4740", "MCDB4750", "MCDB4850", "MCDB4860", "MCDB4950", "MCDB4960"] or course.code in ["BENG4630", "BENG4767", "CPSC4750", "MATH2460", "MATH2510", "MB&B3520", "MB&B4350", "MB&B5230", "MCDB3200", "MCDB3620"];
}

requirement labs "Two MCDB half-credit laboratories (labs used as an elective do not also count here)" [core] {
  courses at least 2 where course.code in ["MCDB2010L", "MCDB2030L", "MCDB2210L", "MCDB2310L", "MCDB2510L", "MCDB2910L", "MCDB3030L", "MCDB3210L", "MCDB3410L", "MCDB3420L", "MCDB3430L", "MCDB3440L", "MCDB3450L"];
}

requirement senior "Senior requirement: yearlong independent research, MCDB 4850 and 4860, in the senior year" [senior] {
  courses exactly 2 from [MCDB 4850, MCDB 4860];
  constraint senior_year "Taken in the senior year": all where attempt.year_of_study = 4;
}

// The concentration course is required for all degrees; the concentration elective fills a general or special elective.
requirement concentration_course "Quantitative Biology concentration: MCDB 3310" [concentration] {
  slot from [MCDB 3310];
}

constraint concentration_elective "Quantitative Biology concentration: one concentration-related elective in place of a general or special elective"
    in requirements [general_electives, special_elective]:
  at least 1 attempts where course.code in ["BENG4630", "BENG4767", "CPSC4750", "MATH2460", "MATH2510", "MB&B3520", "MB&B4350", "MB&B5230", "MCDB3200", "MCDB3620"];

constraint letter_grades "No course taken Credit/D/Fail counts, including prerequisites" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses taken elsewhere count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_credits "At least 9 course credits beyond the prerequisites" in roles [core, elective, concentration, senior]:
  total at least 9 credits;
