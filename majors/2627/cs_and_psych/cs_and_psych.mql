// Computer Science and Psychology B.A. -- 14 term courses beyond the prerequisite (8 CPSC, 6 PSYC), plus the senior project.
$ai = [RANGE(CPSC 4700, CPSC 4770), CPSC 4520, CPSC 4530, RANGE(CPSC 4810, CPSC 4890)];
$cogsub = PLACEMENT("Cognitive psychology or cognitive science course (not counted toward PSYC) approved by both DUSs");

SELECT 1 FROM [PSYC 1100, PLACEMENT("Score of 5 on the AP Psychology exam")] : "Prerequisite: PSYC 1100" : 1;

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 2 FROM [CPSC 2230, CPSC 3230] : "CPSC 2230 and 3230" : 1;
SELECT 1 FROM [CPSC 3650, CPSC 3660] : "Algorithms (CPSC 3650 or 3660; only one may count)" : 1;
// CPSC 2800 and CPSC 4900 may not count; one relevant cognitive course may substitute with permission of both DUSs.
SELECT 3 FROM [$ai, $ai, $ai, $cogsub] : "Three advanced computer science courses in artificial intelligence" : 2;
LIMIT 1 FROM $cogsub : "At most one cognitive psychology/science substitution for an AI course" : 2;

SELECT 1 FROM [S&DS 1000, S&DS 2300] : "Statistics (S&DS 1000 or 2300)" : 1;
SELECT 1 FROM [RANGE(PSYC 2100, PSYC 2990)] : "Research methods course (PSYC 2100-2990)" : 2;
SELECT 2 FROM [TAG("YC PSYC Social Science Core"), SELECT 1 FROM [TAG("YC PSYC Social Science"), TAG("YC PSYC Social Science Core")]] : "Two psychology courses from the social science point of view (at least one Core)" : 2;
SELECT 2 FROM [TAG("YC PSYC Natural Science Core"), SELECT 1 FROM [TAG("YC PSYC Natural Science"), TAG("YC PSYC Natural Science Core")]] : "Two psychology courses from the natural science point of view (at least one Core)" : 2;

SELECT 1 FROM [CPSC 4900, PSYC 4990] : "Senior project approved by both DUSs" : 1;
