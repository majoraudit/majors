// Psychology B.A. -- neuroscience concentration. 12 courses beyond PSYC 1100, including the senior requirement.
$psyc = RANGE(PSYC 0000, PSYC 9999);
$outside = PLACEMENT("Course in a related department with substantial empirical psychology content, approved in advance by the DUS");

SELECT 1 FROM [PSYC 1100, PLACEMENT("Score of 5 on AP Psychology or 7 on IB Psychology")] : "Prerequisite: PSYC 1100" : 1;
SELECT 1 FROM [S&DS 1000, S&DS 2300, PLACEMENT("S&DS 1230 (YData) or S&DS 2300 for students with AP Statistics 5, with DUS approval")] : "Statistics (S&DS 1000 or 2300), preferably before the senior year" : 1;
SELECT 2 FROM [TAG("YC PSYC Social Science Core"), SELECT 1 FROM [TAG("YC PSYC Social Science"), TAG("YC PSYC Social Science Core")]] : "Two social science courses (at least one Core: PSYC 1400, 1500, 1700)" : 2;
SELECT 4 FROM [BIOL 1010, BIOL 1020, BIOL 1030, BIOL 1040, PLACEMENT("AP Biology 5 or IB Biology 7 placement")] : "Neuroscience: introductory biology (BIOL 1010-1040)" : 1;
SELECT 1 FROM [PSYC 1600, PSYC 2690L, PSYC 2760, MCDB 3200] : "Neuroscience: PSYC 1600 (or PSYC 2690L, 2760, or MCDB 3200)" : 1;
SELECT 1 FROM [TAG("YC PSYC Natural Science"), TAG("YC PSYC Natural Science Core")] : "Neuroscience: one additional natural science course" : 2;
SELECT 1 FROM [TAG("YC PSYC NSCI Track RsrchMthds"), PSYC 2600, PSYC 2538, PSYC 2700, PSYC 2658, PSYC 2670, SELECT 2 FROM [MCDB 3200, MCDB 3210L]] : "Neuroscience: data-collection (research methods) course" : 2;
// Laboratory courses do not count; MCDB 3200 used as a substitute above may not also count here.
SELECT 2 FROM [TAG("YC PSYC NSCI Track Adv Scie"), TAG("YC PSYC NSCI Track Adv Scie"), MCDB 2000, MCDB 2020, MCDB 2050, MCDB 2100, MCDB 2500, MCDB 3000, MCDB 3150, MCDB 3200, EEB 2220, EEB 2225, BENG 3200, BENG 5440, CPSC 4750, MB&B 3000, MB&B 3010, MB&B 4200, MB&B 4350, MB&B 4430, MB&B 3520, MATH 2220, MATH 2250, MATH 2410] : "Neuroscience: two advanced science courses" : 2;
SELECT 2 FROM [$psyc, $psyc, $outside] : "Two electives" : 4;
LIMIT 3 FROM [$outside, $outside, $outside] : "At most three courses from related departments" : 4;
LIMIT 3 FROM [RANGE(PSYC 4900, PSYC 4999), RANGE(PSYC 4900, PSYC 4999), RANGE(PSYC 4900, PSYC 4999)] : "No more than three credits from PSYC 4900-4999" : 4;

// PSYC 4925 and 4950 are Pass/Fail and cannot carry the senior essay.
SELECT 1 FROM [RANGE_TAG(PSYC 4000, PSYC 4899, "YC PSYC NSCI Track Senior Sem"), RANGE_TAG(PSYC 4990, PSYC 4990, "YC PSYC NSCI Track Senior Sem")] : "Senior requirement: senior-year course from PSYC 4000-4899 or 4990 with neuroscience content, with a senior essay of at least 5,000 words (letter grade)" : 1;
SELECT 1 FROM [TAG("YC PSYC NSCI Track Senior Sem")] : "Senior requirement: one additional course credit from PSYC 4000-4999 with neuroscience content" : 1;
