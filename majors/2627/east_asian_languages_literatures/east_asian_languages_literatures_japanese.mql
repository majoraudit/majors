// East Asian Languages and Literatures B.A. (Japanese concentration): eleven term courses beyond the prerequisite,
// including a one-term senior essay (twelve with a yearlong essay).
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/east-asian-languages-literatures/
program east_asian_languages_literatures_japanese {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact language_placement "Placement beyond intermediate Chinese, Japanese, or Korean":
  placement { test: "EALL language placement", result: "beyond 1400" };

requirement prereq "Prerequisite: CHNS 1400, JAPN 1400, or KREN 1400, or the equivalent" [prerequisite] {
  slot from [CHNS 1400, JAPN 1400, KREN 1400];
}

effect placed when fact language_placement: waive prereq;

requirement advanced_language "Two terms of advanced Japanese: JAPN 1500 and 1510, or equivalents" [language] {
  courses at least 2 where course.code in ["JAPN1500", "JAPN1510"] or attempt.approved_for contains "advanced_language";
}

requirement literary_language "Literary Japanese: JAPN 1700" [language] {
  slot from [JAPN 1700];
}

requirement survey "A survey course in Chinese, Japanese, Korean, or East Asian history and culture, preferably early" [core] {
  slot where attempt.approved_for contains "survey";
}

requirement translation "Three literature-in-translation courses taught in English (EALL 2000-3999, including theater and film), one premodern" [core] {
  courses at least 3 where course.subject = "EALL" and course.number >= 2000 and course.number <= 3999;
  constraint premodern "One focused primarily on premodern content":
    at least 1 attempts where attempt.approved_for contains "premodern";
}

requirement advanced_reading "Three advanced courses with readings in literary or modern Chinese, Japanese, and/or Korean" [language] {
  courses at least 3
    where course.subject in ["CHNS", "JAPN", "KREN"] and course.distributionals contains "L5"
      or attempt.approved_for contains "advanced_reading";
}

// The second term of a yearlong essay cannot replace any of the eleven required courses; exclusivity enforces this.
requirement senior "Senior essay: EALL 4910 (one term), or EALL 4920 and 4930 (yearlong)" [senior] {
  children at least 1;
  requirement senior_one_term "EALL 4910" { slot from [EALL 4910]; }
  requirement senior_yearlong "EALL 4920 and 4930" { courses exactly 2 from [EALL 4920, EALL 4930]; }
}

constraint crdf_limit "At most one Credit/D/Fail course counts, with DUS permission" in program:
  limit 1 attempts where attempt.grading_mode = "crdf";

constraint crdf_permission "Credit/D/Fail courses count only with DUS permission" in program:
  all where attempt.grading_mode = "letter" or attempt.approved_for contains "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "At least eleven term courses beyond the prerequisite" in roles [core, language, senior]:
  total at least 11 attempts;
