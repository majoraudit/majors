// East Asian Languages and Literatures B.A. -- Japanese concentration.
// 11 term courses beyond the prerequisite including a one-term senior essay (12 with a yearlong essay).
$advreading = [DIST_DEPT("L5", "CHNS"), DIST_DEPT("L5", "JAPN"), DIST_DEPT("L5", "KREN"), PLACEMENT("Advanced course with readings in literary or modern Chinese, Japanese, or Korean, approved by the DUS")];
$lit = RANGE(EALL 2000, EALL 3999);

SELECT 1 FROM [CHNS 1400, JAPN 1400, KREN 1400, PLACEMENT("Equivalent of intermediate Chinese, Japanese, or Korean by placement")] : "Prerequisite: CHNS 1400, JAPN 1400, KREN 1400, or equivalent" : 1;

SELECT 1 FROM [JAPN 1500, PLACEMENT("Equivalent of JAPN 1500 approved by the DUS")] : "Advanced language: JAPN 1500 or equivalent" : 1;
SELECT 1 FROM [JAPN 1510, PLACEMENT("Equivalent of JAPN 1510 approved by the DUS")] : "Advanced language: JAPN 1510 or equivalent" : 1;
SELECT 1 FROM JAPN 1700 : "Literary Japanese (JAPN 1700)" : 1;

SELECT 1 FROM PLACEMENT("Survey course in Chinese, Japanese, Korean, or East Asian history and culture, approved by the DUS") : "Survey course in East Asian history and culture" : 2;
SELECT 3 FROM [$lit, $lit, $lit] : "Three literature-in-translation courses (EALL 2000-3999; may include theater and film)" : 2;
SELECT 1 FROM PLACEMENT("One of the EALL 2000-3999 literature courses focused primarily on premodern content") : "One literature-in-translation course with premodern content" : 2;
SELECT 3 FROM [$advreading, $advreading, $advreading] : "Three advanced courses with readings in literary or modern Chinese, Japanese, and/or Korean" : 3;

// The second term of a yearlong essay may not substitute for any of the eleven required courses.
SELECT 1 FROM [CLASS(EALL 4910), SELECT 2 FROM [EALL 4920, EALL 4930]] : "Senior essay (EALL 4910, or yearlong EALL 4920 and 4930)" : 1;
