// Engineering Sciences (Mechanical) B.A.: eight approved course credits in engineering beyond the prerequisites, including the senior project.
// Students consult the DUS at the beginning of sophomore year.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/mechanical-engineering/
program engineering_sciences_mechanical_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement prereq_calculus "Prerequisite: MATH 1120 and 1150" [prerequisite] {
  courses exactly 2 from [MATH 1120, MATH 1150];
}

requirement prereq_physics "Prerequisite: PHYS 1700 and 1710 or higher" [prerequisite] {
  courses at least 2 from [PHYS 1700, PHYS 1710, PHYS 1800, PHYS 1810, PHYS 2000, PHYS 2010, PHYS 2600, PHYS 2610];
}

requirement electives "Seven MENG electives selected with DUS approval" [elective] {
  credits at least 7 where course.subject = "MENG" or attempt.approved_for contains "electives";
}

requirement senior "Senior project: MENG 4991 or 4992, or another upper-level design course chosen with the DUS, in the senior year" [senior] {
  slot where course.code in ["MENG4991", "MENG4992"] or attempt.approved_for contains "senior";
  constraint senior_year "Taken in the senior year": all where attempt.year_of_study = 4;
}

constraint one_special_project "At most one of MENG 4991 or 4992 counts toward the major" in program:
  limit 1 attempts where course.code in ["MENG4991", "MENG4992"];

constraint letter_grades "No course taken Credit/D/Fail counts, including prerequisites" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_credits "Eight course credits in engineering beyond the prerequisites" in roles [elective, senior]:
  total at least 8 credits;
