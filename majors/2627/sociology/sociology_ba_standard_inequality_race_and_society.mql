// Sociology B.A. -- Inequality, Race, and Society concentration, non-intensive (standard) senior requirement. 13 term courses including the senior requirement.
// No more than two introductory courses in any department or program may count toward the major.
$socy = RANGE(SOCY 0000, SOCY 9999);
$outside = PLACEMENT("Concentration-relevant course from outside Sociology approved by the DUS");

SELECT 1 FROM [RANGE(SOCY 1000, SOCY 1999)] : "One introductory sociology course (1000 level)" : 2;
SELECT 1 FROM [SOCY 1700, PLACEMENT("Similar gateway course approved by the DUS")] : "Gateway course (SOCY 1700)" : 2;
SELECT 1 FROM [SOCY 2001, SOCY 2002] : "Sociological theory (SOCY 2001 or 2002)" : 1;
SELECT 1 FROM SOCY 2100 : "Research design (SOCY 2100), usually spring of junior year" : 1;
SELECT 1 FROM [S&DS 1000, S&DS 1100, S&DS 3630, GLBL 2122, PLACEMENT("Statistics course approved by the DUS")] : "One statistics course" : 2;
$ineq = [RANGE_TAG(SOCY 2000, SOCY 3999, "YC SOCY InequalityRaceSociety"), PLACEMENT("2000- or 3000-level course related to race or inequality approved by the DUS")];
SELECT 6 FROM [$ineq, $ineq, $ineq, $ineq, $ineq, $ineq] : "Six electives related to race or inequality (2000 and 3000 level)" : 4;
LIMIT 4 FROM [$outside, $outside, $outside, $outside] : "Up to 4 concentration-relevant courses from outside Sociology (DUS approval)" : 4;

SELECT 2 FROM [SOCY 4100, RANGE(SOCY 3000, SOCY 3999)] : "Senior requirement (non-intensive): senior essay in SOCY 4100 and an additional 3000-level Sociology seminar, integrating race and/or inequality" : 1;
