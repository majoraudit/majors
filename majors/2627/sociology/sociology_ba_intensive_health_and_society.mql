// Sociology B.A. -- Health and Society concentration, intensive senior requirement. 13 term courses including the senior requirement.
// No more than two introductory courses in any department or program may count toward the major.
$socy = RANGE(SOCY 0000, SOCY 9999);
$outside = PLACEMENT("Concentration-relevant course from outside Sociology approved by the DUS");

SELECT 1 FROM [SOCY 1600, SOCY 1601, PLACEMENT("Similar gateway course approved by the DUS")] : "Gateway course (SOCY 1600 or 1601)" : 2;
SELECT 1 FROM [SOCY 2001, SOCY 2002] : "Sociological theory (SOCY 2001 or 2002)" : 1;
SELECT 1 FROM [S&DS 1000, S&DS 1100, S&DS 3630, PLACEMENT("Social science methodology course approved by the DUS")] : "One social science methodology course" : 2;
SELECT 1 FROM SOCY 2100 : "Research design (SOCY 2100), usually spring of junior year" : 1;
SELECT 2 FROM [RANGE_TAG(SOCY 2000, SOCY 3999, "YC SOCY Health & Society"), RANGE_TAG(SOCY 2000, SOCY 3999, "YC SOCY Health & Society"), PLACEMENT("Intermediate/advanced Sociology course relevant to health approved by the DUS")] : "Two intermediate or advanced Sociology courses relevant to the concentration" : 2;
// At least one outside course is recommended from BIOL 1010-1040, MATH 1120 or higher, or ECON 2170.
$health = [BIOL 1010, BIOL 1020, BIOL 1030, BIOL 1040, RANGE(MATH 1120, MATH 9999), ECON 2170, PLACEMENT("Health-related course from outside Sociology approved by the DUS")];
SELECT 5 FROM [$socy, $socy, $socy, $socy, $socy, $health, $health, $health, $health, $health] : "Five electives relevant to the concentration" : 4;
LIMIT 5 FROM [$health, $health, $health, $health, $health] : "Up to five course credits from outside Sociology (DUS approval)" : 4;

SELECT 2 FROM [SOCY 4200, SOCY 4201] : "Senior requirement (intensive): yearlong senior essay in SOCY 4200 and 4201, integrating health and medicine" : 1;
SELECT 1 FROM PLACEMENT("Intensive major admission arranged with the DUS by spring registration of the junior year") : "Intensive major admission" : 1;
