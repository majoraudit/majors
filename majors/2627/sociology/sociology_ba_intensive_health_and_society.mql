// Sociology B.A. (Health and Society concentration, intensive senior requirement): thirteen term courses including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/sociology/
// No more than two introductory courses in any department or program may count (checked for the departments these tracks use).
program sociology_ba_intensive_health_and_society {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact intensive_approval "Intensive senior essay arranged with the DUS by spring registration of junior year": approval dus_approval { for: "intensive" };

requirement intensive_admission "Admission to the intensive senior requirement" [senior] {
  slot where attempt.approved_for contains "intensive";
}

effect intensive_admitted when fact intensive_approval: waive intensive_admission;

requirement gateway "Gateway course: SOCY 1600 or 1601, or a similar approved course" [core] {
  slot where course.code in ["SOCY1600", "SOCY1601"] or attempt.approved_for contains "gateway";
}

requirement theory "Sociological theory: SOCY 2001 or 2002" [core] {
  slot from [SOCY 2001, SOCY 2002];
}

requirement methodology "One social science methodology course" [core] {
  slot where course.code in ["S&DS1000", "S&DS1100", "S&DS3630"] or attempt.approved_for contains "methodology";
}

requirement research_design "Research design: SOCY 2100, usually in the spring of junior year" [core] {
  slot from [SOCY 2100];
}

requirement health_courses "Two intermediate or advanced Sociology courses relevant to the concentration" [core] {
  courses at least 2 where course.subject = "SOCY" and course.number >= 2000 and course.number <= 3999 and course.attributes contains "YC SOCY Health & Society" or attempt.approved_for contains "health_courses";
}

requirement electives "Five electives relevant to the concentration (an outside course from BIOL 1010-1040, MATH 1120 or higher, or ECON 2170 is recommended)" [elective] {
  courses at least 5 where course.subject = "SOCY" or course.code in ["BIOL1010", "BIOL1020", "BIOL1030", "BIOL1040", "ECON2170"] or course.subject = "MATH" and course.number >= 1120 or attempt.approved_for contains "outside_concentration";
}

requirement senior "Senior requirement (intensive): a yearlong senior essay in SOCY 4200 and 4201, integrating health and medicine" [senior] {
  courses exactly 2 from [SOCY 4200, SOCY 4201];
}

constraint intro_limit_socy "No more than two introductory courses (below 2000) in Sociology" in program:
  limit 2 attempts where course.subject = "SOCY" and course.number <= 1999;

constraint intro_limit_sds "No more than two introductory courses (below 2000) in Statistics and Data Science" in program:
  limit 2 attempts where course.subject = "S&DS" and course.number <= 1999;

constraint intro_limit_biol "No more than two introductory courses (below 2000) in Biology" in program:
  limit 2 attempts where course.subject = "BIOL" and course.number <= 1999;

constraint intro_limit_math "No more than two introductory courses (below 2000) in Mathematics" in program:
  limit 2 attempts where course.subject = "MATH" and course.number <= 1999;

constraint intro_limit_econ "No more than two introductory courses (below 2000) in Economics" in program:
  limit 2 attempts where course.subject = "ECON" and course.number <= 1999;

constraint outside_limit "Up to 5 concentration-relevant courses from outside Sociology, with DUS approval" in program:
  limit 5 attempts where course.subject != "SOCY";

constraint crdf_limit "At most two Credit/D/Fail courses count toward the major" in program:
  limit 2 attempts where attempt.grading_mode = "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Thirteen term courses including the senior requirement" in roles [core, elective, senior]:
  total at least 13 attempts;
