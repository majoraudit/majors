// Astronomy B.A. -- 10 courses beyond the prerequisites, including the senior requirement.
SELECT 1 FROM [
    SELECT 2 FROM [PHYS 1700, PHYS 1710],
    SELECT 2 FROM [PHYS 1800, PHYS 1810],
    SELECT 2 FROM [PHYS 2000, PHYS 2010]
] : "Prerequisite: introductory physics sequence" : 1;
SELECT 3 FROM [MATH 1120, MATH 1150, SELECT 1 FROM [MATH 1200, ENAS 1510]] : "Prerequisite: MATH 1120, MATH 1150, and MATH 1200 or ENAS 1510" : 1;

SELECT 1 FROM [ASTR 2100, ASTR 2200] : "ASTR 2100 or ASTR 2200" : 1;
SELECT 1 FROM ASTR 2550 : "ASTR 2550" : 1;
SELECT 1 FROM ASTR 3100 : "ASTR 3100" : 1;
SELECT 1 FROM [RANGE(ASTR 2000, ASTR 9999)] : "One additional astronomy elective numbered 2000 or higher" : 2;

$math = [RANGE(MATH 2000, MATH 9999), RANGE(S&DS 2000, S&DS 9999), RANGE(CPSC 2000, CPSC 9999), ASTR 3560, PLACEMENT("Advanced mathematical methods course approved by the DUS")];
SELECT 2 FROM [$math, $math] : "Two advanced mathematics or mathematical methods courses (statistics or computer science count)" : 3;

$sci3 = [RANGE(ASTR 3000, ASTR 9999), RANGE(PHYS 3000, PHYS 9999), RANGE(APHY 3000, APHY 9999), RANGE(MATH 3000, MATH 9999), RANGE(S&DS 3000, S&DS 9999), RANGE(CPSC 3000, CPSC 9999), RANGE(CHEM 3000, CHEM 9999), RANGE(EPS 3000, EPS 9999), RANGE(ENAS 3000, ENAS 9999), PLACEMENT("Natural, applied, or mathematical science course numbered 3000 or higher")];
$sci = [RANGE(ASTR 0000, ASTR 9999), RANGE(PHYS 0000, PHYS 9999), RANGE(APHY 0000, APHY 9999), RANGE(MATH 0000, MATH 9999), RANGE(S&DS 0000, S&DS 9999), RANGE(CPSC 0000, CPSC 9999), RANGE(CHEM 0000, CHEM 9999), RANGE(EPS 0000, EPS 9999), RANGE(ENAS 0000, ENAS 9999), RANGE(BIOL 0000, BIOL 9999), PLACEMENT("Natural, applied, or mathematical science course")];
SELECT 2 FROM [$sci3, $sci3] : "Science electives: two numbered 3000 or higher" : 4;
SELECT 1 FROM [$sci] : "Science electives: one additional natural, applied, or mathematical science course" : 5;

SELECT 1 FROM ASTR 4920 : "Senior essay or research project" : 1;
