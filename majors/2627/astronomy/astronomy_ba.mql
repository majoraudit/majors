// Astronomy B.A.: ten courses beyond the prerequisites, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/astronomy/
program astronomy_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement prereq_physics "Prerequisite: PHYS 1700 and 1710, PHYS 1800 and 1810, or PHYS 2000 and 2010" [prerequisite] {
  children at least 1;
  requirement prereq_physics_1700 "PHYS 1700 and 1710" { courses exactly 2 from [PHYS 1700, PHYS 1710]; }
  requirement prereq_physics_1800 "PHYS 1800 and 1810" { courses exactly 2 from [PHYS 1800, PHYS 1810]; }
  requirement prereq_physics_2000 "PHYS 2000 and 2010" { courses exactly 2 from [PHYS 2000, PHYS 2010]; }
}

requirement prereq_calculus "Prerequisite: MATH 1120 and 1150" [prerequisite] {
  courses exactly 2 from [MATH 1120, MATH 1150];
}

requirement prereq_multivariable "Prerequisite: MATH 1200 or ENAS 1510" [prerequisite] {
  slot from [MATH 1200, ENAS 1510];
}

requirement intro_astronomy "ASTR 2100 or 2200" [core] {
  slot from [ASTR 2100, ASTR 2200];
}

requirement astr_2550 "ASTR 2550" [core] {
  slot from [ASTR 2550];
}

requirement astr_3100 "ASTR 3100" [core] {
  slot from [ASTR 3100];
}

requirement astronomy_elective "One additional Astronomy elective numbered 2000 or higher" [elective] {
  slot where course.subject = "ASTR" and course.number >= 2000;
}

requirement mathematics "Two advanced mathematics or mathematical methods courses (MATH 2000+, statistics, computer science, or ASTR 3560)" [core] {
  courses at least 2
    where course.subject = "MATH" and course.number >= 2000
      or course.subject in ["S&DS", "CPSC"] and course.number >= 2000
      or course.code = "ASTR3560"
      or attempt.approved_for contains "mathematics";
}

requirement science_electives "Three electives in the natural, applied, or mathematical sciences, at least two numbered 3000 or higher" [elective] {
  courses at least 3
    where course.distributionals contains "Sc"
      or course.subject in ["ASTR", "PHYS", "APHY", "MATH", "AMTH", "S&DS", "CPSC", "CHEM", "EPS", "ENAS", "BIOL", "MCDB", "MB&B", "E&EB", "BENG", "CENG", "ECE", "MENG", "ENVE"];
  constraint advanced_science "At least two numbered 3000 or higher":
    at least 2 attempts where course.number >= 3000;
}

requirement senior "Senior essay or research project (ASTR 4920)" [senior] {
  slot from [ASTR 4920];
}

constraint letter_grades "No course taken Credit/D/Fail counts toward the major" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Ten courses beyond the prerequisites" in roles [core, elective, senior]:
  total at least 10 attempts;
