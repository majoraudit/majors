// Ecology and Evolutionary Biology B.A. (Biodiversity and the Environment concentration): 3.5 course credits beyond the
// prerequisites, plus the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/ecology-evolutionary-biology/
program eeb_ba_biodiversity_environment {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact biology_placement "Placed out of BIOL 1010-1040 by the biology placement examination":
  placement { test: "Biology placement examination", result: "pass" };

requirement prereq_biology "Prerequisite: BIOL 1010, 1020, 1030, and 1040" [prerequisite] {
  courses exactly 4 from [BIOL 1010, BIOL 1020, BIOL 1030, BIOL 1040];
}

effect biology_placed when fact biology_placement: waive prereq_biology;

// Acceleration credit or advanced courses in chemistry, mathematics, or physics may replace those prerequisites.
requirement prereq_chemistry "Prerequisite: general chemistry CHEM 1610 and 1650, or CHEM 1630 and 1670" [prerequisite] {
  children at least 1;
  requirement prereq_chem_1610 "CHEM 1610 and 1650" { courses exactly 2 from [CHEM 1610, CHEM 1650]; }
  requirement prereq_chem_1630 "CHEM 1630 and 1670" { courses exactly 2 from [CHEM 1630, CHEM 1670]; }
  requirement prereq_chem_accelerated "Acceleration credit or an advanced chemistry course accepted by the DUS" {
    slot where attempt.source = "acceleration" and course.subject = "CHEM" or attempt.approved_for contains "prereq_chemistry";
  }
}

requirement prereq_chemistry_lab "Prerequisite: CHEM 1340L and 1360L" [prerequisite] {
  courses exactly 2 where course.code in ["CHEM1340L", "CHEM1360L"] or attempt.approved_for contains "prereq_chemistry_lab";
}

requirement prereq_quantitative "Prerequisite: one term of mathematics (MATH 1150, 1160, or 1200) or statistics (S&DS 1000-1060 or 2300)" [prerequisite] {
  slot where course.code in ["MATH1150", "MATH1160", "MATH1200", "S&DS2300"]
      or course.subject = "S&DS" and course.number >= 1000 and course.number <= 1060
      or attempt.source = "acceleration" and course.subject = "MATH";
}

requirement prereq_additional "Prerequisite: four or five additional quantitative and physical science courses totaling four credits" [prerequisite] {
  credits at least 4
    where course.code in [
        "MATH1150", "MATH1160", "MATH1180", "MATH1200", "MATH2220", "MATH2250", "MATH2350", "MATH2410",
        "MATH2420", "MATH2440", "MATH2460", "MATH2470", "MATH2550", "S&DS2200", "S&DS2300", "S&DS2380",
        "S&DS2400", "CPSC1001", "CPSC1230", "CPSC2010", "CHEM1740", "CHEM2200", "CHEM1750", "CHEM2210",
        "CHEM2220L", "CHEM2230L", "PHYS1700", "PHYS1800", "PHYS1710", "PHYS1810", "EPS1100", "EPS2120",
        "EPS2200", "EPS2220", "EPS2320", "EPS2400", "EPS2550"
      ]
      or course.subject = "S&DS" and course.number >= 1000 and course.number <= 1060
      or attempt.source = "acceleration" and course.subject in ["CHEM", "MATH", "PHYS"];
  constraint per_department "No more than two of these courses from the same department":
    group course.subject at most 2 per group;
}

requirement core "Biodiversity and the Environment: EEB 2220 and 2225" [core] {
  courses exactly 2 from [EEB 2220, EEB 2225];
}

requirement diversity "A lecture course on organismal diversity with its laboratory (usually EEB 2246-2272; or EEB 3326 and 3327L; others such as MCDB 2900 and 2910L with DUS approval)" [core] {
  credits at least 1.5
    where course.subject = "EEB" and course.number >= 2246 and course.number <= 2272
      or course.attributes contains "YC E&EB Organismal Lec/Labs"
      or course.code in ["EEB3326", "EEB3327L"]
      or attempt.approved_for contains "diversity";
  constraint diversity_lab "Including the associated laboratory": at least 1 attempts where course.format = "lab";
}

requirement senior "Senior requirement: EEB 4470, or a senior essay approved by the DUS" [senior] {
  slot where course.code = "EEB4470" or attempt.approved_for contains "senior";
}

constraint letter_grades "No course taken Credit/D/Fail counts, including prerequisites" in program:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.source = "acceleration" or attempt.approved_for contains "major";

constraint total_credits "3.5 course credits beyond the prerequisites, not counting the senior requirement" in roles [core, elective]:
  total at least 3.5 credits;
