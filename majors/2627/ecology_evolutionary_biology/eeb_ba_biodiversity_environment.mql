// Ecology and Evolutionary Biology B.A. -- Biodiversity and the Environment concentration. 3.5 course credits beyond the prerequisites, plus the senior requirement.
$math = [MATH 1150, MATH 1160, MATH 1180, MATH 1200, MATH 2220, MATH 2250, MATH 2350, MATH 2410, MATH 2420, MATH 2440, MATH 2460, MATH 2470, MATH 2550];
$sds = [RANGE(S&DS 1000, S&DS 1060), S&DS 2200, S&DS 2300, S&DS 2380, S&DS 2400];
$cpsc = [CPSC 1001, CPSC 1230, CPSC 2010];
$chem = [CHEM 1740, CHEM 2200, CHEM 1750, CHEM 2210, CHEM 2220L, CHEM 2230L];
$phys = [PHYS 1700, PHYS 1800, PHYS 1710, PHYS 1810];
$eps = [EPS 1100, EPS 2120, EPS 2200, EPS 2220, EPS 2320, EPS 2400, EPS 2550];
$accel = PLACEMENT("Acceleration credit or advanced course accepted in place of the prerequisite");

SELECT 4 FROM [SELECT 1 FROM [BIOL 1010, PLACEMENT("Biology placement examination")], SELECT 1 FROM [BIOL 1020, PLACEMENT("Biology placement examination")], SELECT 1 FROM [BIOL 1030, PLACEMENT("Biology placement examination")], SELECT 1 FROM [BIOL 1040, PLACEMENT("Biology placement examination")]] : "Prerequisite: BIOL 1010-1040" : 1;
SELECT 1 FROM [SELECT 2 FROM [CHEM 1610, CHEM 1650], SELECT 2 FROM [CHEM 1630, CHEM 1670], $accel] : "Prerequisite: two-term general chemistry lecture sequence" : 1;
SELECT 1 FROM [SELECT 2 FROM [CHEM 1340L, CHEM 1360L], $accel] : "Prerequisite: general chemistry laboratories" : 1;
SELECT 1 FROM [MATH 1150, MATH 1160, MATH 1200, RANGE(S&DS 1000, S&DS 1060), S&DS 2300, $accel] : "Prerequisite: one term of mathematics or statistics" : 1;
// Four or five courses totaling four credits; laboratories are half-credit.
SELECT 4-5 FROM [$math, $sds, $cpsc, $chem, $phys, $eps, $accel, $accel] : "Prerequisite: additional quantitative and physical science courses totaling four credits" : 1;
LIMIT 2 FROM $math : "No more than two additional prerequisites from Mathematics" : 1;
LIMIT 2 FROM $sds : "No more than two additional prerequisites from Statistics and Data Science" : 1;
LIMIT 2 FROM $cpsc : "No more than two additional prerequisites from Computer Science" : 1;
LIMIT 2 FROM $chem : "No more than two additional prerequisites from Chemistry" : 1;
LIMIT 2 FROM $phys : "No more than two additional prerequisites from Physics" : 1;
LIMIT 2 FROM $eps : "No more than two additional prerequisites from Earth and Planetary Sciences" : 1;

SELECT 2 FROM [EEB 2220, EEB 2225] : "Biodiversity and the Environment: EEB 2220 and 2225" : 1;
SELECT 1 FROM [
    SELECT 2 FROM [RANGE(EEB 2246, EEB 2272), TAG("YC E&EB Organismal Lec/Labs")],
    SELECT 2 FROM [EEB 3326, EEB 3327L],
    SELECT 2 FROM [MCDB 2900, MCDB 2910L],
    PLACEMENT("Other organismal diversity lecture course with laboratory approved by the DUS")
] : "Organismal diversity lecture course with associated laboratory (EEB 2246-2272, or EEB 3326 and 3327L)" : 2;

SELECT 1 FROM [EEB 4470, PLACEMENT("Senior essay approved by the DUS (separate from course work)")] : "Senior requirement: EEB 4470 or senior essay" : 1;
