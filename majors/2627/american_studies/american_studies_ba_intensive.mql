// American Studies B.A. (intensive) -- 14 term courses including the senior requirement.
$gateway = RANGE(AMST 1000, AMST 2999);
$conc = PLACEMENT("Concentration course approved by the DUS (letter grade)");
$amst = RANGE(AMST 0000, AMST 9999);

SELECT 4 FROM [
    SELECT 2 FROM [RANGE_TAG(AMST 1000, AMST 2999, "YC AMST Cultural Hist/Studies"), RANGE_TAG(AMST 1000, AMST 2999, "YC AMST Cultural Hist/Studies")],
    SELECT 1 FROM [RANGE_TAG(AMST 1000, AMST 2999, "YC AMST Survey of Am Lit")],
    SELECT 1 FROM [$gateway, PLACEMENT("First-Year Seminar substituted for a gateway course with DUS permission")],
    $gateway
] : "Four gateway courses: two cultural history/studies, one American literature survey, one concentration preparatory course" : 1;
SELECT 1 FROM [TAG("YC AMST Early Americas")] : "One gateway course must carry the Early Americas attribute" : 1;

SELECT 2 FROM [RANGE(AMST 3000, AMST 3999), RANGE(AMST 3000, AMST 3999)] : "Two junior seminars (one in the area of concentration)" : 2;

// One term of AMST 4493/4494 may count toward the concentration.
SELECT 5 FROM [$conc, $conc, $conc, $conc, $conc, AMST 4493, AMST 4494] : "Five courses in the area of concentration (one from a non-U.S. perspective)" : 3;
SELECT 1 FROM PLACEMENT("Concentration course on a comparable topic from a non-U.S. perspective") : "Non-U.S. perspective course within the concentration" : 3;

SELECT 2 FROM [$amst, $amst] : "Two American Studies electives" : 4;

SELECT 2 FROM [AMST 4493, AMST 4494] : "Senior requirement: two-term intensive senior project" : 1;
