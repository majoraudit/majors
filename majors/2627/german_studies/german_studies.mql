// German Studies B.A. -- 10 course credits including the senior essay.
// The intensive major replaces one advanced seminar with GMAN 4930, the second term of the senior essay.
$gman = RANGE(GMAN 1600, GMAN 9999);

SELECT 1 FROM [GMAN 1400, PLACEMENT("Equivalent of first- and second-year German by placement")] : "Prerequisite: first- and second-year German or equivalent" : 1;

SELECT 1 FROM [RANGE(GMAN 1500, GMAN 1599)] : "One GMAN course numbered in the 1500s" : 2;
SELECT 1 FROM [RANGE(GMAN 1600, GMAN 1699)] : "One GMAN course numbered in the 1600s" : 2;
SELECT 1 FROM [RANGE(GMAN 1700, GMAN 1799)] : "One GMAN course numbered in the 1700s" : 2;
SELECT 6 FROM [$gman, $gman, $gman, $gman, $gman, $gman, GMAN 4930] : "Six additional courses numbered GMAN 1600 and above (Groups B and C)" : 3;

SELECT 1 FROM GMAN 4920 : "Senior essay tutorial (GMAN 4920; intensive major continues in GMAN 4930)" : 1;
