// English B.A. (Creative Writing concentration): fifteen courses including the senior requirement:
// four creative writing courses and at least eleven literature courses (courses numbered 1030 or below count as literature).
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/english-language-literature/
program english_ba_creative_writing {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact library_meeting "Met with a research librarian within the first four weeks of the first term of the senior requirement":
  approval dus_approval { for: "library" };

requirement foundational "Three foundational courses from ENGL 1025-1028 (DRST 0001-0002, or ENGL 1029-1030, may replace one)" [literature] {
  children at least 3;
  requirement found_1025 "ENGL 1025" { slot from [ENGL 1025]; }
  requirement found_1026 "ENGL 1026" { slot from [ENGL 1026]; }
  requirement found_1027 "ENGL 1027" { slot from [ENGL 1027]; }
  requirement found_1028 "ENGL 1028" { slot from [ENGL 1028]; }
  requirement found_drst "DRST 0001 and 0002 together" { courses exactly 2 from [DRST 0001, DRST 0002]; }
  requirement found_1029 "ENGL 1029 and 1030 together" { courses exactly 2 from [ENGL 1029, ENGL 1030]; }
  requirement found_substitute "Two overlapping upper-level courses in place of one foundational course, with DUS permission" {
    courses exactly 2 where attempt.approved_for contains "found_substitute";
  }
  constraint one_replacement "At most one foundational course is replaced" in subtree foundational:
    at most 2 attempts where not course.code in ["ENGL1025", "ENGL1026", "ENGL1027", "ENGL1028"];
}

// Introductory courses (numbered 1030 or below) do not fulfill the period requirements.
requirement periods "One course in each historical period" [literature] {
  children exactly 4;
  requirement period_medieval "Medieval" { slot where course.attributes contains "YC ENGL Medieval" and course.number > 1030; }
  requirement period_renaissance "Renaissance" { slot where course.attributes contains "YC ENGL Renaissance" and course.number > 1030; }
  requirement period_18_19 "18th/19th century" { slot where course.attributes contains "YC ENGL 18th/19th Century" and course.number > 1030; }
  requirement period_20_21 "20th/21st century" { slot where course.attributes contains "YC ENGL 20th/21st Century" and course.number > 1030; }
}

requirement junior_seminar "A junior literature (non-creative writing) seminar" [literature] {
  slot where course.attributes contains "YC ENGL Junior Seminar";
}

requirement library "Library requirement: a meeting with a research librarian in the first term of the senior requirement" [senior] {
  slot where attempt.approved_for contains "library";
}

effect library_done when fact library_meeting: waive library;

fact cw_admission "Admitted to the creative writing concentration (application at the end of the junior year)":
  approval committee_approval { for: "creative_writing" };

requirement admission "Admission to the creative writing concentration" [senior] {
  slot where attempt.approved_for contains "creative_writing";
}

effect admitted when fact cw_admission: waive admission;

requirement electives "Two additional literature electives, to reach eleven literature courses" [literature] {
  courses at least 2 where course.subject = "ENGL" and not course.attributes contains "YC ENGL Creative Writing" or attempt.approved_for contains "outside_elective";
}

requirement creative_writing "Four creative writing courses" [creative_writing] {
  children exactly 3;
  requirement cw_project "ENGL 4400, the senior project tutorial" { slot from [ENGL 4400]; }
  requirement cw_workshops "Two 4000-level designated creative writing courses requiring an application, one in the genre of ENGL 4400, by the end of fall of senior year" {
    courses at least 2
      where course.subject = "ENGL" and course.number >= 4000 and course.code != "ENGL4400"
        and course.attributes contains "YC ENGL Creative Writing";
  }
  requirement cw_other_genre "One designated creative writing course in another genre" {
    slot where course.attributes contains "YC ENGL Creative Writing" and course.code != "ENGL4400";
  }
}

requirement senior "Senior requirement: a senior seminar or a one-term senior essay (ENGL 4100), with ENGL 4400" [senior, literature] {
  slot where course.attributes contains "YC ENGL Senior Seminar" or course.code = "ENGL4100";
}

constraint intro_limit "At most five introductory courses (numbered 1030 or below; ENGL 1020 and 1023 count as introductory)" in program:
  limit 5 attempts where course.subject = "ENGL" and course.number <= 1030;

constraint outside_limit "At most two courses from other departments, as electives only, with DUS permission" in program:
  limit 2 attempts where course.subject != "ENGL" and not course.code in ["DRST0001", "DRST0002"];

constraint crdf_limit "At most four Credit/D/Fail courses count toward the major" in program:
  limit 4 attempts where attempt.grading_mode = "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint eleven_literature "At least eleven literature courses" in roles [literature]:
  total at least 11 attempts;

constraint total_courses "Fifteen courses in all" in roles [literature, creative_writing, senior]:
  total at least 15 attempts;
