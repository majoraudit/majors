// Political Science B.A. -- interdisciplinary concentration, standard major. 12 term courses including the senior requirement.
$plsc = RANGE(PLSC 0000, PLSC 9999);
$seminar = [RANGE(PLSC 3000, PLSC 4899), PLACEMENT("Residential College Seminar taught by Political Science faculty")];
$outside = PLACEMENT("Related course in another department (or DRST 0005/0006, or one outside Residential College Seminar) approved by the DUS");

SELECT 2 FROM [TAG("YC PLSC Intro Courses"), TAG("YC PLSC Intro Courses"), RANGE(PLSC 1000, PLSC 1999), RANGE(PLSC 1000, PLSC 1999)] : "Two introductory courses (first digit 1)" : 2;
SELECT 2 FROM [TAG("YC PLSC Core Lecture"), TAG("YC PLSC Core Lecture")] : "Two non-introductory core lectures" : 2;
SELECT 1 FROM [TAG("YC PLSC Method &Formal Theory")] : "One course in the methodology and formal theory subfield" : 2;
SELECT 2 FROM [$seminar, $seminar] : "Two seminars taught by Political Science faculty (at least one in the senior year)" : 2;

$conc = [$plsc, $outside];
SELECT 7 FROM [$conc, $conc, $conc, $conc, $conc, $conc, $conc] : "Seven courses in the interdisciplinary field of concentration (application approved by the DUS)" : 3;
SELECT 2 FROM [
    SELECT 2 FROM [TAG("YC PLSC American Govt"), TAG("YC PLSC American Govt")],
    SELECT 2 FROM [TAG("YC PLSC Comparative Govt"), TAG("YC PLSC Comparative Govt")],
    SELECT 2 FROM [TAG("YC PLSC Internatl Relations"), TAG("YC PLSC Internatl Relations")],
    SELECT 2 FROM [TAG("YC PLSC Political Philosophy"), TAG("YC PLSC Political Philosophy")]
] : "Outside the concentration: two courses in each of two subfields (international relations, American government, political philosophy, comparative politics)" : 2;
LIMIT 3 FROM [$outside, $outside, $outside] : "At most 3 courses from other departments (DUS permission)" : 3;

SELECT 1 FROM [
    PLACEMENT("Senior seminar taught by Political Science faculty"),
    CLASS(PLSC 4900),
    SELECT 2 FROM [PLSC 4900, PLSC 4901]
] : "Senior requirement (on a subject within the concentration): senior seminar, one-term essay (PLSC 4900), or yearlong essay (PLSC 4900 and 4901)" : 1;
