// Applied Mathematics B.A.: eleven term courses beyond the prerequisites, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/applied-mathematics/
// The breadth-area lists are the catalog's; the DUS keeps a longer list, which reaches the audit as approvals.
program applied_mathematics_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement prereq_calculus "Prerequisite: multivariable calculus (MATH 1200 or ENAS 1510)" [prerequisite] {
  slot from [MATH 1200, ENAS 1510];
}

requirement prereq_linear_algebra "Prerequisite: linear algebra (MATH 2220, 2250, or 2260)" [prerequisite] {
  slot from [MATH 2220, MATH 2250, MATH 2260];
}

requirement prereq_programming "Prerequisite: computer programming (ENAS 1300 or CPSC 1001)" [prerequisite] {
  slot from [ENAS 1300, CPSC 1001];
}

requirement differential_equations "Differential equations (ENAS 1940 or MATH 2460)" [core] {
  slot from [ENAS 1940, MATH 2460];
}

requirement probability "Probability (S&DS 2410 or 2380)" [core] {
  slot from [S&DS 2410, S&DS 2380];
}

requirement data_analysis "Data analysis (S&DS 3610 or 2300)" [core] {
  slot from [S&DS 3610, S&DS 2300];
}

requirement discrete "Discrete mathematics (AMTH 2440 or CPSC 2020)" [core] {
  slot from [AMTH 2440, CPSC 2020];
}

requirement breadth "Courses in at least three breadth areas, with DUS approval" [breadth] {
  children at least 3;
  requirement breadth_optimization "(a) optimization" {
    slot from [
        AMTH 4310, AMTH 4370, ECE 4000, CPSC 4850, S&DS 4320
      ];
  }
  requirement breadth_probability_statistics "(b) probability and statistics" {
    slot from [
        S&DS 2420, S&DS 3120, S&DS 3510, S&DS 3640, S&DS 4000, S&DS 4100, S&DS 4110, S&DS 4250,
        ECON 2136, APHY 4700
      ];
  }
  requirement breadth_pde_analysis "(c) partial differential equations and analysis" {
    slot from [
        MATH 2470, MATH 2550, MATH 2560, MATH 2600, MATH 3020, MATH 3050, MATH 3100, MATH 3200,
        MATH 3250, MATH 4470, AMTH 4280
      ];
  }
  requirement breadth_algorithms_numerical "(d) algorithms and numerical methods" {
    slot from [
        CPSC 3650, CPSC 3660, CPSC 4240, CPSC 4371, CPSC 4410, CPSC 4650, CPSC 4660, CPSC 4670,
        CPSC 4680, CPSC 4690, CPSC 6400, ENAS 4040, ENAS 4041
      ];
  }
  requirement breadth_graph_theory "(e) graph theory" {
    slot from [
        AMTH 3620, AMTH 4200, AMTH 5620, MATH 7990, CPSC 4620
      ];
  }
  requirement breadth_mathematical_economics "(f) mathematical economics" {
    slot from [
        ECON 2125, ECON 2126, ECON 3350, ECON 3351, ECON 4417, ECON 4428, ECON 4433, ECON 4471,
        CPSC 4550
      ];
  }
  requirement breadth_engineering "(g) engineering" {
    slot from [
        ECE 4390, AMTH 3420, S&DS 3640, MENG 2311, MENG 2615, MENG 3422, MENG 3465, MENG 3323,
        MENG 4463, MENG 4469, CENG 3010, CENG 3150
      ];
  }
  requirement breadth_machine_learning "(h) data mining and machine learning" {
    slot from [
        S&DS 2620, S&DS 2660, S&DS 3650, S&DS 6690, S&DS 6710, S&DS 6850, CPSC 4391, CPSC 4520,
        CPSC 4530, CPSC 4700, CPSC 4740, CPSC 4770, CPSC 3810, CPSC 4830, CPSC 4860, CPSC 4880,
        CPSC 7450, AMTH 5520, AMTH 2320
      ];
  }
  requirement breadth_biological_modeling "(i) biological modeling and computation" {
    slot from [
        CPSC 4530, CPSC 4750, CPSC 4760, BENG 3400, BENG 4450, BENG 4580, PSYC 2658
      ];
  }
  requirement breadth_physical_sciences "(j) physical sciences" {
    credits at least 1
      where course.code in [
        "ASTR3200", "ASTR4200", "CHEM3330", "EPS3220", "EPS3230", "EPS4210", "EPS4280", "EPS4560",
        "EPS5290", "EPS6590", "PHYS3430", "PHYS3440", "PHYS4010", "PHYS4020", "PHYS4100", "PHYS4120",
        "PHYS4500", "PHYS4300", "PHYS4400", "PHYS4410", "PHYS4420", "APHY4390", "APHY4480"
      ]
        or course.subject = "CHEM" and course.number >= 4100 and attempt.approved_for contains "breadth";
  }
  requirement breadth_linguistics_philosophy "(k) mathematical linguistics and philosophy" {
    slot from [
        LING 2249, LING 2270, LING 3800, PHIL 2267, PHIL 4427, MATH 2700
      ];
  }
  requirement breadth_approved "Course in another breadth area approved by the DUS" {
    courses between 1 and 3 where attempt.approved_for contains "breadth";
  }
}

requirement concentration "Three advanced courses in a concentration applying mathematics to one field" [concentration] {
  children at least 1;
  requirement concentration_optimization "(a) optimization" {
    courses at least 3 from [
        AMTH 4310, AMTH 4370, ECE 4000, CPSC 4850, S&DS 4320
      ];
    constraint concentration_optimization_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_probability_statistics "(b) probability and statistics" {
    courses at least 3 from [
        S&DS 2420, S&DS 3120, S&DS 3510, S&DS 3640, S&DS 4000, S&DS 4100, S&DS 4110, S&DS 4250,
        ECON 2136, APHY 4700
      ];
    constraint concentration_probability_statistics_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_pde_analysis "(c) partial differential equations and analysis" {
    courses at least 3 from [
        MATH 2470, MATH 2550, MATH 2560, MATH 2600, MATH 3020, MATH 3050, MATH 3100, MATH 3200,
        MATH 3250, MATH 4470, AMTH 4280
      ];
    constraint concentration_pde_analysis_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_algorithms_numerical "(d) algorithms and numerical methods" {
    courses at least 3 from [
        CPSC 3650, CPSC 3660, CPSC 4240, CPSC 4371, CPSC 4410, CPSC 4650, CPSC 4660, CPSC 4670,
        CPSC 4680, CPSC 4690, CPSC 6400, ENAS 4040, ENAS 4041
      ];
    constraint concentration_algorithms_numerical_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_graph_theory "(e) graph theory" {
    courses at least 3 from [
        AMTH 3620, AMTH 4200, AMTH 5620, MATH 7990, CPSC 4620
      ];
    constraint concentration_graph_theory_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_mathematical_economics "(f) mathematical economics" {
    courses at least 3 from [
        ECON 2125, ECON 2126, ECON 3350, ECON 3351, ECON 4417, ECON 4428, ECON 4433, ECON 4471,
        CPSC 4550
      ];
    constraint concentration_mathematical_economics_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_engineering "(g) engineering" {
    courses at least 3 from [
        ECE 4390, AMTH 3420, S&DS 3640, MENG 2311, MENG 2615, MENG 3422, MENG 3465, MENG 3323,
        MENG 4463, MENG 4469, CENG 3010, CENG 3150
      ];
    constraint concentration_engineering_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_machine_learning "(h) data mining and machine learning" {
    courses at least 3 from [
        S&DS 2620, S&DS 2660, S&DS 3650, S&DS 6690, S&DS 6710, S&DS 6850, CPSC 4391, CPSC 4520,
        CPSC 4530, CPSC 4700, CPSC 4740, CPSC 4770, CPSC 3810, CPSC 4830, CPSC 4860, CPSC 4880,
        CPSC 7450, AMTH 5520, AMTH 2320
      ];
    constraint concentration_machine_learning_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_biological_modeling "(i) biological modeling and computation" {
    courses at least 3 from [
        CPSC 4530, CPSC 4750, CPSC 4760, BENG 3400, BENG 4450, BENG 4580, PSYC 2658
      ];
    constraint concentration_biological_modeling_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_physical_sciences "(j) physical sciences" {
    courses at least 3 from [
        ASTR 3200, ASTR 4200, CHEM 3330, EPS 3220, EPS 3230, EPS 4210, EPS 4280, EPS 4560,
        EPS 5290, EPS 6590, PHYS 3430, PHYS 3440, PHYS 4010, PHYS 4020, PHYS 4100, PHYS 4120,
        PHYS 4500, PHYS 4300, PHYS 4400, PHYS 4410, PHYS 4420, APHY 4390, APHY 4480
      ];
    constraint concentration_physical_sciences_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_linguistics_philosophy "(k) mathematical linguistics and philosophy" {
    courses at least 3 from [
        LING 2249, LING 2270, LING 3800, PHIL 2267, PHIL 4427, MATH 2700
      ];
    constraint concentration_linguistics_philosophy_level "At least two numbered 3000 or above":
      at least 2 attempts where course.number >= 3000;
  }
  requirement concentration_nonstandard "Nonstandard concentration of three advanced courses approved by the DUS" {
    courses at least 3 where attempt.approved_for contains "concentration";
  }
}

requirement senior "Senior thesis research project (AMTH 4910)" [senior] {
  slot from [AMTH 4910];
}

constraint crdf_limit "At most one Credit/D/Fail course counts toward the major" in program:
  limit 1 attempts where attempt.grading_mode = "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Eleven term courses beyond the prerequisites" in roles [core, breadth, concentration, senior]:
  total at least 11 attempts;
