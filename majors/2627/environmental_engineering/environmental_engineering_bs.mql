// Environmental Engineering B.S. -- at least 13 term course credits beyond the prerequisites, including the senior requirement.
SELECT 2 FROM [MATH 1120, MATH 1150] : "Prerequisite: MATH 1120 and 1150" : 1;
SELECT 1 FROM [MATH 1200, ENAS 1510] : "Prerequisite: MATH 1200 or ENAS 1510" : 1;
SELECT 1 FROM ENAS 1940 : "Prerequisite: ENAS 1940" : 1;
SELECT 1 FROM [ENAS 1300, S&DS 2300] : "Prerequisite: ENAS 1300 or S&DS 2300" : 1;
SELECT 1 FROM [SELECT 4 FROM [CHEM 1610, CHEM 1650, CHEM 1340L, CHEM 1360L], SELECT 4 FROM [CHEM 1630, CHEM 1670, CHEM 1340L, CHEM 1360L]] : "Prerequisite: two-term lecture sequence in chemistry with laboratories" : 1;
SELECT 2 FROM [PHYS 1800, PHYS 1810] : "Prerequisite: PHYS 1800 and 1810" : 1;
SELECT 1 FROM [SELECT 2 FROM [BIOL 1010, BIOL 1020], SELECT 2 FROM [BIOL 1030, BIOL 1040]] : "Prerequisite: BIOL 1010 and 1020, or BIOL 1030 and 1040" : 1;

SELECT 1 FROM [CENG 3000, MENG 2511] : "CENG 3000 or MENG 2511" : 1;
SELECT 3 FROM [ENVE 1200, ENVE 3600, ENVE 3730] : "ENVE 1200, 3600, and 3730" : 1;
SELECT 1 FROM [ENVE 3140, ENVE 4480] : "ENVE 3140 or 4480" : 1;
SELECT 1 FROM [ENVE 4380, ENVE 4400] : "ENVE 4380 or 4400" : 1;
SELECT 2 FROM [ENVE 4410, ENVE 4420] : "ENVE 4410 and 4420" : 1;

// Electives may build toward an optional emphasis: Climate and Energy; Environmental Science and Technology;
// Sustainability and Policy; or Self-designed.
$technical = PLACEMENT("Technical elective chosen in consultation with the DUS");
$elective = PLACEMENT("Elective chosen in consultation with the DUS");
SELECT 4 FROM [$technical, $technical, $technical, $technical, $elective] : "At least four electives approved by the DUS" : 3;
SELECT 3 FROM [$technical, $technical, $technical] : "At least three of the electives must be technical electives" : 3;

SELECT 1 FROM [ENVE 4160, ENVE 4900] : "Senior requirement (ENVE 4160 or 4900)" : 1;
