// Italian Studies B.A.: eleven term courses beyond the prerequisite, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/italian-studies/
program italian_studies_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact italian_placement "Placement equivalent to ITAL 1300 (L3)": placement { test: "Italian placement", result: "L3" };
fact senior_meetings "Met with the DUS at least twice a month in the senior year and with department faculty at the end of the final semester":
  approval dus_approval { for: "senior_meetings" };

requirement prereq "Prerequisite: ITAL 1300 (L3) or an equivalent" [prerequisite] {
  slot from [ITAL 1300];
}

effect placed when fact italian_placement: waive prereq;

requirement ital_1400 "ITAL 1400 or an equivalent" [italian] {
  slot where course.code = "ITAL1400" or attempt.approved_for contains "ital_1400";
}

requirement ital_1500 "ITAL 1500 or 1510" [italian] {
  slot from [ITAL 1500, ITAL 1510];
}

requirement survey "A survey course on Italian literature: ITAL 4162 or 4172" [italian] {
  slot from [ITAL 4162, ITAL 4172];
}

requirement dante "A course on Dante's Divine Comedy: ITAL 1310 or an equivalent" [italian] {
  slot where course.code = "ITAL1310" or attempt.approved_for contains "dante";
}

requirement ital_electives "Four additional Italian Studies courses numbered 1400 or above (including graduate courses)" [italian] {
  courses at least 4 where course.subject = "ITAL" and course.number >= 1400 and course.code != "ITAL4491";
}

requirement related "Two related courses in other departments approved by the DUS (one may be a graduate course in another national literature or linguistics)" [elective] {
  courses at least 2 where attempt.approved_for contains "related";
  constraint one_graduate "At most one graduate course": at most 1 attempts where course.number >= 5000;
}

requirement senior "Senior essay written in Italian (ITAL 4491), in the senior year" [senior] {
  slot from [ITAL 4491];
  constraint senior_year "Completed in the senior year": all where attempt.year_of_study = 4;
}

requirement meetings "Regular senior-year meetings with the DUS and a concluding meeting with department faculty" [senior] {
  slot where attempt.approved_for contains "senior_meetings";
}

effect meetings_done when fact senior_meetings: waive meetings;

constraint taught_in_italian "At least five of the eight Italian Studies courses conducted in Italian" in roles [italian]:
  at least 5 attempts where course.attributes contains "YC ITAL Taught in Italian";

constraint taught_in_english "No more than three Italian department courses taught in English" in program:
  limit 3 attempts where course.attributes contains "YC ITAL Taught in English";

constraint crdf_limit "At most one Credit/D/Fail course counts, excluding the senior essay" in program:
  limit 1 attempts where attempt.grading_mode = "crdf";

constraint senior_letter "The senior essay is not taken Credit/D/Fail" in direct senior:
  all where attempt.grading_mode = "letter";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint eight_italian "Eight Italian Studies courses numbered 1400 or above" in roles [italian]:
  total at least 8 attempts;

constraint total_courses "Eleven term courses beyond the prerequisite" in roles [italian, elective, senior]:
  total at least 11 attempts;
