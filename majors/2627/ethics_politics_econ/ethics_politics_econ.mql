// Ethics, Politics, and Economics B.A. -- 15 courses including the eight introductory courses and the senior requirement.
// Two full terms of Directed Studies fulfill the first three introductory requirements.
$conc = PLACEMENT("Concentration seminar or course defined with DUS review (at most one lecture)");

SELECT 1 FROM [PHIL 1175, SELECT 2 FROM [DRST 0001, DRST 0002]] : "Introductory: ethics (PHIL 1175 or Directed Studies)" : 1;
SELECT 1 FROM [RANGE(ANTH 0000, ANTH 9999), RANGE(ER&M 0000, ER&M 9999), RANGE(HIST 0000, HIST 9999), RANGE(SOCY 0000, SOCY 9999), RANGE(WGSS 0000, WGSS 9999), SELECT 2 FROM [DRST 0001, DRST 0002], PLACEMENT("Other Perspectives course from another discipline approved by the DUS")] : "Introductory: Other Perspectives course" : 1;
SELECT 1 FROM [PHIL 1178, PLSC 1327, PLSC 1335, PLSC 1352, SELECT 2 FROM [DRST 0001, DRST 0002]] : "Introductory: political philosophy" : 1;
SELECT 1 FROM [PLSC 1113, PLSC 1413, PLSC 1222] : "Introductory: political science (PLSC 1113, 1413, or 1222)" : 1;
SELECT 1 FROM [ECON 1108, ECON 1110, ECON 1115] : "Introductory: microeconomics" : 1;
SELECT 1 FROM [ECON 1111, ECON 1116] : "Introductory: macroeconomics" : 1;
SELECT 1 FROM [ECON 1117, ECON 2123, ECON 2135, GLBL 2121, S&DS 2300, S&DS 2380] : "Introductory: econometrics" : 1;
SELECT 1 FROM [EP&E 4220, EP&E 4231, EP&E 4295, EP&E 4297, ECON 2159] : "Introductory: game theory" : 1;

SELECT 1 FROM [ECON 2121, ECON 2125] : "Intermediate microeconomics" : 1;

SELECT 1 FROM [EP&E 3212, EP&E 3213, EP&E 3214, EP&E 3215, EP&E 3216, EP&E 3217] : "Core seminar from the EP&E Classics series" : 2;
SELECT 2 FROM [
    SELECT 1 FROM [TAG("YC EP&E Ethics Core")],
    SELECT 1 FROM [TAG("YC EP&E Politics Core")],
    SELECT 1 FROM [TAG("YC EP&E Economics Core")]
] : "Two core seminars from two of the three core areas" : 2;
SELECT 1 FROM [TAG("YC EP&E Advanced Seminar")] : "One core seminar must be an advanced seminar anchored in at least two core areas" : 2;

SELECT 2 FROM [$conc, $conc] : "Two courses in the area of concentration (three including the senior essay course)" : 3;
LIMIT 1 FROM PLACEMENT("Lecture course in the area of concentration") : "At most one concentration course may be a lecture" : 3;

SELECT 1 FROM [
    CLASS(EP&E 4491),
    SELECT 2 FROM [EP&E 4492, EP&E 4493],
    PLACEMENT("Senior essay written in a relevant seminar with instructor consent and DUS approval")
] : "Senior essay in the area of concentration" : 1;
