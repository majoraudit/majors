// Ancient and Modern Greek B.A. -- 12 term courses including the senior requirement.
// Modern Greek is listed as HELN in the catalog; the parser's department list only accepts MGRK.
$grek = RANGE(GREK 3000, GREK 4999);
$heln = RANGE(MGRK 1300, MGRK 9999);

SELECT 1 FROM GREK 4995 : "GREK 4995" : 1;
SELECT 4 FROM [GREK 4995, $grek, $grek, $grek] : "Four ancient Greek courses numbered 3000 or above" : 2;

SELECT 1 FROM [RANGE_TAG(CLCV 1000, CLCV 2999, "YC CLSS Lit/Cult Anc Greece")] : "Course covering broadly the literature and/or culture of ancient Greece (CLCV 1000/2000-level)" : 2;
SELECT 1 FROM [RANGE_TAG(CLCV 1000, CLCV 2999, "YC CLSS Lit/Cult Anc Rome")] : "Course covering broadly the literature and/or culture of ancient Rome (CLCV 1000/2000-level)" : 2;
SELECT 1 FROM [TAG("YC CLSS Ancient Hist Greece")] : "Course in ancient Greek history" : 2;
SELECT 1 FROM [PLACEMENT("Course in the history, history of art, literature, or culture of the Greek-speaking Balkans or Hellenic diaspora (medieval, Ottoman, or modern), approved by the DUS"), RANGE(MGRK 0000, MGRK 9999)] : "Course on the medieval, Ottoman, or modern Greek-speaking world" : 3;

SELECT 2 FROM [$heln, $heln] : "Two modern Greek courses at the intermediate level (HELN 1300, 1400) or above" : 2;

SELECT 1 FROM [
    SELECT 2 FROM [CLSS 4998, CLSS 4999],
    SELECT 2 FROM [
        SELECT 1 FROM [CLSS 4998, CLSS 4999],
        SELECT 1 FROM [RANGE(CLCV 0000, CLCV 9999), RANGE(CLSS 0000, CLSS 9999), RANGE(LATN 0000, LATN 9999), RANGE(GREK 0000, GREK 9999), PLACEMENT("Relevant course in another field approved by the DUS")]
    ]
] : "Senior Tutorial: two terms (CLSS 4998 and 4999), or one term plus an additional course" : 1;

