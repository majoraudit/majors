// Anthropology B.A. -- Concentration in Biological Anthropology -- 12 course credits including the senior requirement.
$anth = RANGE(ANTH 0000, ANTH 9999);
$adv = RANGE(ANTH 3000, ANTH 4999);
$cognate = PLACEMENT("Cognate course in another department approved by the DUS");

SELECT 1 FROM [RANGE_TAG(ANTH 1000, ANTH 2999, "YC ANTH Biological")] : "Introductory/intermediate course: evolution of human and nonhuman primates (biological)" : 1;
SELECT 1 FROM [RANGE_TAG(ANTH 1000, ANTH 2999, "YC ANTH Archaeology")] : "Introductory/intermediate course: archaeological study of human societies" : 1;
SELECT 1 FROM [RANGE_TAG(ANTH 1000, ANTH 2999, "YC ANTH Sociocultural"), RANGE_TAG(ANTH 1000, ANTH 2999, "YC ANTH Linguistic")] : "Introductory/intermediate course: social, cultural, and linguistic dimensions" : 1;

// ANTH 4071, ANTH 4091, and a seminar used for the senior essay do not count here.
SELECT 3 FROM [RANGE(ANTH 3000, ANTH 4070), RANGE(ANTH 4072, ANTH 4090), RANGE(ANTH 4092, ANTH 4999), RANGE(ANTH 3000, ANTH 4070), RANGE(ANTH 4072, ANTH 4090), RANGE(ANTH 4092, ANTH 4999), RANGE(ANTH 3000, ANTH 4070), RANGE(ANTH 4072, ANTH 4090), RANGE(ANTH 4092, ANTH 4999)] : "Three advanced ANTH courses (3000-4000 level), excluding senior essay work" : 2;
LIMIT 3 FROM [$cognate, $cognate, $cognate] : "At most three cognate courses from other departments" : 2;

// Remaining credits (ANTH 4071 counts here for the yearlong essay option).
SELECT 5 FROM [$anth, $anth, $anth, $anth, $anth, $cognate, $cognate, $cognate] : "Anthropology electives or approved cognates" : 4;

// Concentration requirements (six credits, not including the senior project).
SELECT 1 FROM ANTH 1400 : "Biological anthropology: ANTH 1400" : 1;
SELECT 1 FROM [RANGE_TAG(ANTH 3000, ANTH 4999, "YC ANTH Biological")] : "Biological anthropology: at least one advanced seminar" : 2;
SELECT 4 FROM [TAG("YC ANTH Biological"), TAG("YC ANTH Biological"), TAG("YC ANTH Biological"), TAG("YC ANTH Biological"), PLACEMENT("Biological anthropology cognate approved by the DUS"), PLACEMENT("Biological anthropology cognate approved by the DUS"), PLACEMENT("Biological anthropology cognate approved by the DUS")] : "Biological anthropology: four seminar or cognate electives" : 3;

SELECT 1 FROM [CLASS(ANTH 4091), SELECT 2 FROM [ANTH 4071, ANTH 4091]] : "Senior essay in the concentration subfield (ANTH 4091, or yearlong ANTH 4071 and ANTH 4091; seminar essays do not qualify)" : 1;
