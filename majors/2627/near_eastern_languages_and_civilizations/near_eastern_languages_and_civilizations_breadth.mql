// Near Eastern Languages and Civilizations B.A. (Breadth concentration): twelve term courses including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/near-eastern-languages-civilizations/
// Students develop a coherent program with the DUS.
program near_eastern_languages_and_civilizations_breadth {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

requirement language "Four term courses in Near Eastern languages" [language] {
  courses at least 4 where course.subject in ["ARBC", "HEBR", "PERS", "TKSH", "AKKD", "EGYP", "ARMN", "OTTM"] or attempt.approved_for contains "language";
}

requirement foundations "Two NELC Foundations courses" [core] {
  courses at least 2 where course.attributes contains "YC NELC Foundations Course";
}

requirement electives "Five NELC electives: one each on the ancient Near East, the medieval Near East, and the modern Middle East" [elective] {
  courses at least 5 where course.subject = "NELC" and not course.code in ["NELC4920", "NELC4930"] or attempt.approved_for contains "nelc_elective";
  constraint ancient "One on the ancient Near East": at least 1 attempts where course.attributes contains "YC NELC Ancient Near East";
  constraint medieval "One on the medieval Near East": at least 1 attempts where course.attributes contains "YC NELC Medieval Near East";
  constraint modern "One on the modern Middle East": at least 1 attempts where course.attributes contains "YC NELC Modern Middle East";
}

requirement senior "Senior project: NELC 4920 and/or 4930, or an expanded upper-level seminar paper approved in advance by the instructor and the DUS" [senior] {
  children at least 1;
  requirement senior_project "NELC 4920 and/or 4930" { courses between 1 and 2 from [NELC 4920, NELC 4930]; }
  requirement senior_seminar "An expanded upper-level seminar research paper" {
    slot where course.subject = "NELC" and course.format = "seminar" and attempt.approved_for contains "senior";
  }
}

constraint crdf_limit "At most one Credit/D/Fail course counts toward the major" in program:
  limit 1 attempts where attempt.grading_mode = "crdf";

constraint outside_limit "At most two outside credits (other institutions or study abroad), with DUS approval" in program:
  limit 2 credits where attempt.source != "yale";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Twelve term courses including the senior requirement" in program:
  total at least 12 attempts;
