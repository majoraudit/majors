// Electrical Engineering and Computer Science B.S. -- 15 term courses beyond the prerequisites, including the senior project.
// Acceleration credits may not satisfy prerequisites; MATH 1160 may not replace MATH 1150, nor MATH 1210 replace MATH 1200.
$ee = [RANGE(ECE 3000, ECE 4679), RANGE(ECE 4692, ECE 4999), SELECT 1 FROM [ECE 4680, ECE 4691], PLACEMENT("Electrical engineering elective in another department approved by both DUSs")];
$cs = [RANGE(CPSC 3000, CPSC 4899), RANGE(CPSC 4901, CPSC 4999), PLACEMENT("Computer science elective in another department approved by both DUSs")];

SELECT 1 FROM [MATH 1120, PLACEMENT("Equivalent of one year of high school calculus")] : "Prerequisite: MATH 1120" : 1;
SELECT 1 FROM [MATH 1150, PLACEMENT("Equivalent of one year of high school calculus")] : "Prerequisite: MATH 1150" : 1;
SELECT 1 FROM [ENAS 1510, MATH 1200, RANGE(MATH 2000, MATH 9999)] : "Prerequisite: ENAS 1510 or MATH 1200 (or higher)" : 1;
SELECT 1 FROM [CPSC 1001, PLACEMENT("Previous programming experience")] : "Prerequisite: CPSC 1001 (students without programming experience)" : 1;
SELECT 1 FROM [SELECT 2 FROM [PHYS 1800, PHYS 1810], SELECT 2 FROM [PHYS 2000, PHYS 2010], SELECT 2 FROM [PHYS 1700, PHYS 1710]] : "Prerequisite: physics (PHYS 1700, 1710 only for students taking MATH 1120)" : 1;

SELECT 1 FROM CPSC 2010 : "CPSC 2010" : 1;
SELECT 1 FROM [CPSC 2020, MATH 2440] : "Discrete mathematics (CPSC 2020 or MATH 2440)" : 1;
SELECT 2 FROM [CPSC 2230, CPSC 3230] : "CPSC 2230 and 3230" : 1;
SELECT 1 FROM [CPSC 3650, CPSC 3660] : "Algorithms (CPSC 3650 or 3660; only one may count)" : 1;
SELECT 4 FROM [ECE 2000, ECE 2011, ECE 2020, ECE 2031] : "ECE 2000, 2011, 2020, and 2031" : 1;
SELECT 1 FROM [MATH 2220, MATH 2250, MATH 2260, S&DS 2380, S&DS 2410] : "Linear algebra or probability (MATH 2220, 2250, 2260, S&DS 2380, or 2410)" : 1;

// Cross-titled courses may count either way; CPSC 2900 and 4900 may not be used as electives.
SELECT 2 FROM [$ee, $ee] : "Two advanced electrical engineering electives (3000- or 4000-level)" : 3;
SELECT 2 FROM [$cs, $cs] : "Two advanced computer science electives (3000- or 4000-level)" : 3;

SELECT 1 FROM [CLASS(CPSC 4900), CLASS(ECE 4710), CLASS(ECE 4721), SELECT 2 FROM [ECE 4710, ECE 4721]] : "Senior project (CPSC 4900, or ECE 4710 and/or 4721), approved by both DUSs" : 1;
