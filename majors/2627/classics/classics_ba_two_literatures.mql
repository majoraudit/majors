// Classics B.A. -- Two literatures concentration. 12 term courses including the senior requirement.
$grek = RANGE(GREK 3000, GREK 4999);
$latn = RANGE(LATN 3000, LATN 4999);

SELECT 1 FROM [GREK 4995, LATN 4995] : "GREK 4995 or LATN 4995" : 1;
SELECT 6 FROM [GREK 4995, LATN 4995, $grek, $grek, $grek, $grek, $grek, $latn, $latn, $latn, $latn, $latn] : "Six Greek and Latin language courses numbered 3000 or above" : 2;
SELECT 2 FROM [$grek, $grek] : "At least two Greek courses numbered 3000 or above" : 2;
SELECT 2 FROM [$latn, $latn] : "At least two Latin courses numbered 3000 or above" : 2;

SELECT 1 FROM [RANGE_TAG(CLCV 1000, CLCV 2999, "YC CLSS Lit/Cult Anc Greece")] : "Course covering broadly the literature and/or culture of ancient Greece (CLCV 1000/2000-level)" : 2;
SELECT 1 FROM [RANGE_TAG(CLCV 1000, CLCV 2999, "YC CLSS Lit/Cult Anc Rome")] : "Course covering broadly the literature and/or culture of ancient Rome (CLCV 1000/2000-level)" : 2;
SELECT 1 FROM [TAG("YC CLSS Ancient Hist Greece"), TAG("YC CLSS Ancient Hist Rome")] : "Course in ancient history" : 2;
SELECT 1 FROM [TAG("YC CLSS Ancient Hist Greece"), TAG("YC CLSS Ancient Hist Rome"), TAG("YC CLSS Hist, Phil, Art, Arcg"), RANGE(CLCV 0000, CLCV 9999)] : "Additional course in ancient history, classical art and archaeology, ancient philosophy, or classical civilization" : 3;

SELECT 1 FROM [
    SELECT 2 FROM [CLSS 4998, CLSS 4999],
    SELECT 2 FROM [
        SELECT 1 FROM [CLSS 4998, CLSS 4999],
        SELECT 1 FROM [RANGE(CLCV 0000, CLCV 9999), RANGE(CLSS 0000, CLSS 9999), RANGE(LATN 0000, LATN 9999), RANGE(GREK 0000, GREK 9999), PLACEMENT("Relevant course in another field approved by the DUS")]
    ]
] : "Senior Tutorial: two terms (CLSS 4998 and 4999), or one term plus an additional course" : 1;
