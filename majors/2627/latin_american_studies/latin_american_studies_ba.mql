// Latin American Studies B.A.: twelve term courses beyond the prerequisite, including the senior requirement.
// Source: https://catalog.yale.edu/ycps/subjects-of-instruction/latin-american-studies/
// Courses outside the program's listings count if at least a third of the syllabus concerns the region (DUS approval).
program latin_american_studies_ba {
  catalog 2026-2027
  institution "https://majoraudit.org/mql/yale" @ "2026-2027"
  credit_scale 2
}

fact language_placement "Placement at the L3 level or higher in Spanish or Portuguese":
  language_proficiency { language: "Spanish or Portuguese", level: "L3" };

requirement prereq "Prerequisite: Spanish or Portuguese at the L3 level or higher, or the equivalent" [prerequisite] {
  slot where course.subject in ["SPAN", "PORT"] and course.distributionals overlaps ["L3", "L4", "L5"];
}

effect placed when fact language_placement: waive prereq;

requirement intro "One introductory course" [core] {
  slot where course.code = "LAST1100" or attempt.approved_for contains "intro";
}

requirement social_sciences "Latin American content: two courses in the social sciences (anthropology, economics, or political science)" [content] {
  courses at least 2
    where course.subject in ["ANTH", "ECON", "PLSC"] and attempt.approved_for contains "latin_american_content";
}

requirement history "Latin American content: two courses in history" [content] {
  courses at least 2
    where course.attributes contains "YC HIST Latin America"
      or course.subject = "HIST" and attempt.approved_for contains "latin_american_content";
}

requirement literature "Latin American content: two courses in Spanish American or Brazilian literatures, beyond the language requirement" [content] {
  courses at least 2
    where course.subject in ["SPAN", "PORT"] and course.number >= 2000 and attempt.approved_for contains "latin_american_content";
}

requirement arts "Latin American content: one course in art, architecture, film and media studies, music, or theater studies" [content] {
  slot where course.attributes contains "YC HSAR The Americas"
    or course.subject in ["HSAR", "ARCH", "FILM", "MUSI", "TDPS"] and attempt.approved_for contains "latin_american_content";
}

requirement electives "Three additional electives" [elective] {
  courses at least 3 where course.subject = "LAST" or attempt.approved_for contains "latin_american_content";
}

requirement senior "Senior essay (LAST 4491) or senior project (LAST 4492)" [senior] {
  slot from [LAST 4491, LAST 4492];
}

constraint upper_level "Three of the courses are seminars or upper-level courses taken in the junior and senior years" in roles [core, content, elective]:
  at least 3 attempts where attempt.year_of_study >= 3 and (course.format = "seminar" or course.number >= 3000);

constraint taught_l5 "One course is taught in Spanish or Portuguese at the L5 level" in roles [core, content, elective]:
  at least 1 attempts where course.distributionals contains "L5" and course.language in ["Spanish", "Portuguese"];

constraint crdf_limit "At most one Credit/D/Fail course counts toward the major" in program:
  limit 1 attempts where attempt.grading_mode = "crdf";

constraint outside_credit "Courses from another institution or study abroad count only with DUS approval" in program:
  all where attempt.source = "yale" or attempt.approved_for contains "major";

constraint total_courses "Twelve term courses beyond the prerequisite" in roles [core, content, elective, senior]:
  total at least 12 attempts;
